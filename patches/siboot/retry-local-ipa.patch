new file mode 100644
index 0000000..dd71412
--- /dev/null
+++ b/minis/src/onboarding.rs
@@ -0,0 +1,28 @@
+//! Explain the iOS Files picker before the first interactive import.
+use crate::{
+    fail::{Fail, Result},
+    ui,
+};
+use std::{io::Read, path::Path};
+
+pub fn present(home: &Path) -> Result<()> {
+    let marker = home.join("minis-import-guide.v1");
+    if std::fs::File::open(&marker).ok().is_some_and(|file| {
+        let mut bytes = Vec::new();
+        file.take(16).read_to_end(&mut bytes).is_ok() && bytes == b"1\n"
+    }) {
+        return Ok(());
+    }
+    ui::note("Import a local IPA in Minis");
+    ui::note("On the page, choose your IPA from Files. Download an iCloud file to this iPhone first, then select it. Siboot imports it into Minis's Linux filesystem.");
+    ui::note("In the terminal, enter a Linux path inside Minis. A path from another iOS app is not a Minis path.");
+    ui::note("Keep Minis open while importing, signing and installing.");
+    if !ui::confirm("Continue to choose an IPA?", true) {
+        return Err(Fail::by_user("No IPA selected."));
+    }
+    if let Err(error) = isideload::util::fs_storage::write_private(&marker, b"1\n") {
+        ui::warn("The import guide could not be marked as read; it will appear again next time.");
+        ui::detail(&error.to_string());
+    }
+    Ok(())
+}
