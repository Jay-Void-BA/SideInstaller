+enum LoginChoice {
+    Saved(vault::SavedLogin, bool),
+    Manual,
+    Once,
+}
+
+fn saved_login(args: &Args) -> Result<LoginChoice> {
+    if !vault::path(&args.home).exists() {
+        return Ok(LoginChoice::Manual);
+    }
+    loop {
+        let choices = [
+            "Unlock saved Apple Account login",
+            "Unlock and update saved password",
+            "Use another Apple Account once",
+            "Forget saved login",
+        ]
+        .map(str::to_string);
+        match ui::choose("Apple Account login", &choices) {
+            Some(index @ (0 | 1)) => {
+                let phrase = Zeroizing::new(
+                    ui::ask_secret(
+                        "Unlock saved login",
+                        "Unlock passphrase",
+                        "your local storage passphrase",
+                        "Unlock passphrase: ",
+                    )
+                    .map_err(|_| Fail::known("Couldn't read the unlock passphrase."))?
+                    .ok_or_else(|| Fail::by_user("Unlock cancelled."))?,
+                );
+                match vault::unlock(&args.home, &phrase) {
+                    Ok(saved) => return Ok(LoginChoice::Saved(saved, index == 1)),
+                    Err(_) => ui::warn("Couldn't unlock the saved login. Check the passphrase; Apple has not been contacted."),
+                }
+            }
+            Some(2) => return Ok(LoginChoice::Once),
+            Some(3) => {
+                ui::note("This removes the saved login and encrypted local signing data. It does not revoke Apple's certificate.");
+                if ui::confirm("forget the saved login and local signing data?", false) {
+                    vault::forget(&args.home)
+                        .map_err(|_| Fail::known("Couldn't delete the saved login."))?;
+                    return Ok(LoginChoice::Manual);
+                }
+            }
+            _ => return Err(Fail::by_user("Sign-in cancelled.")),
+        }
+    }
+}
