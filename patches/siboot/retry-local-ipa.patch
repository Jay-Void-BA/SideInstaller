+//! Select an iSH pairing file and retain a verified private copy beside siboot.
+
+use std::io::{self, Read};
+use std::path::{Path, PathBuf};
+
+use base64::Engine;
+use idevice::remote_pairing::RpPairingFile;
+use isideload::util::fs_storage::write_private;
+use plist::{Dictionary, Value};
+use serde_json::json;
+use zeroize::Zeroize;
+
+pub const MAX_PAIRING: usize = 64 * 1024;
+
+#[cfg(not(target_os = "wasi"))]
+pub fn default_path() -> PathBuf {
+    std::env::current_exe()
+        .ok()
+        .or_else(|| {
+            let argument = PathBuf::from(std::env::args_os().next()?);
+            if argument.components().count() > 1 || argument.is_absolute() {
+                return argument.canonicalize().ok();
+            }
+            std::env::split_paths(&std::env::var_os("PATH")?)
+                .map(|dir| dir.join(&argument))
+                .find(|p| p.is_file())
+                .and_then(|p| p.canonicalize().ok())
+        })
+        .and_then(|p| p.parent().map(Path::to_path_buf))
+        .unwrap_or_else(working_directory)
+        .join("rp_pairing_file.plist")
+}
+
+#[cfg(target_os = "wasi")]
+pub fn default_path() -> PathBuf {
+    let argument = std::env::args_os()
+        .next()
+        .map(PathBuf::from)
+        .unwrap_or_else(|| "siboot.wasm".into());
+    let cwd = working_directory();
+    // rootshell resolves a bare module name in cwd, then HOME/bin. PATH is
+    // the native shell's PATH and does not describe WASM module lookup.
+    let candidates = if argument.is_absolute() || argument.components().count() > 1 {
+        vec![if argument.is_absolute() {
+            argument
+        } else {
+            cwd.join(argument)
+        }]
+    } else {
+        let home = std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| "/".into());
+        vec![cwd.join(&argument), home.join("bin").join(argument)]
+    };
+    candidates
+        .into_iter()
+        .find(|path| path.is_file())
+        .and_then(|path| path.canonicalize().ok())
+        .and_then(|path| path.parent().map(Path::to_path_buf))
+        .unwrap_or(cwd)
+        .join("rp_pairing_file.plist")
+}
+
+/// Keep native paths unchanged; rootshell's WASI cwd must come from PWD.
+pub fn working_directory() -> PathBuf {
+    #[cfg(target_os = "wasi")]
+    {
+        rootshell_runtime::vfs::working_directory()
+    }
+    #[cfg(not(target_os = "wasi"))]
+    {
+        std::env::current_dir().unwrap_or_else(|_| ".".into())
+    }
+}
+
+pub fn expand_path(path: &Path) -> PathBuf {
+    if path == Path::new("~") {
+        return std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| path.into());
+    }
+    let expanded = match path.strip_prefix("~/") {
+        Ok(rest) => std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .map(|home| home.join(rest))
+            .unwrap_or_else(|| path.into()),
+        Err(_) => path.into(),
+    };
+    #[cfg(target_os = "wasi")]
+    if expanded.is_relative() {
+        return working_directory().join(expanded);
+    }
+    expanded
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "Choose an RPPairing file with matching public/private keys; a classic lockdown pairing file cannot be used here")
+}
+
+pub fn read(path: &Path) -> io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    #[cfg(not(target_os = "wasi"))]
+    let file = std::fs::File::open(path)?;
+    #[cfg(target_os = "wasi")]
+    let file = rootshell_runtime::vfs::File::open(path)?;
+    file.take((MAX_PAIRING + 1) as u64)
+        .read_to_end(&mut bytes)?;
+    normalize(&bytes)
+}
+
+pub fn normalize(bytes: &[u8]) -> io::Result<Vec<u8>> {
+    normalize_nested(bytes, 0)
+}
+
+fn normalize_nested(bytes: &[u8], depth: u8) -> io::Result<Vec<u8>> {
+    if bytes.len() > MAX_PAIRING || depth > 3 {
+        return Err(invalid());
+    }
+    let value = bounded_plist(bytes)
+        .or_else(|_| {
+            let json: serde_json::Value = serde_json::from_slice(bytes).map_err(|_| invalid())?;
+            json_plist(&json).ok_or_else(invalid)
+        })
+        .map_err(|_| invalid())?;
+    decode(value, depth)
+}
+
+// Validate container depth with the iterative event reader before building a
+// recursive Value. A small file can still contain thousands of nested arrays.
+fn bounded_plist(bytes: &[u8]) -> io::Result<Value> {
+    let mut depth = 0usize;
+    for (count, event) in plist::stream::Reader::new(io::Cursor::new(bytes)).enumerate() {
+        if count >= 16_384 {
+            return Err(invalid());
+        }
+        match event.map_err(|_| invalid())? {
+            plist::stream::Event::StartArray(length)
+            | plist::stream::Event::StartDictionary(length) => {
+                if length.is_some_and(|length| length > 16_384) {
+                    return Err(invalid());
+                }
+                depth += 1;
+                if depth > 16 {
+                    return Err(invalid());
+                }
+            }
+            plist::stream::Event::EndCollection => {
+                depth = depth.checked_sub(1).ok_or_else(invalid)?
+            }
+            _ => {}
+        }
+    }
+    plist::from_bytes(bytes).map_err(|_| invalid())
+}
+
+fn decode(value: Value, depth: u8) -> io::Result<Vec<u8>> {
+    if depth > 3 {
+        return Err(invalid());
+    }
+    let Value::Dictionary(dict) = value else {
+        return Err(invalid());
+    };
+    if dict.contains_key("private_key") && dict.contains_key("public_key") {
+        let mut xml = Vec::new();
+        plist::to_writer_xml(&mut xml, &dict).map_err(|_| invalid())?;
+        let file = RpPairingFile::from_bytes(&xml).map_err(|_| invalid())?;
+        if file.identifier.trim().is_empty()
+            || file.e_private_key.verifying_key().to_bytes() != file.e_public_key.to_bytes()
+            || file.alt_irk.as_ref().is_some_and(|irk| irk.len() != 16)
+        {
+            return Err(invalid());
+        }
+        return Ok(file.to_bytes());
+    }
+    for key in [
+        "RPPairing",
+        "RemotePairing",
+        "remote_pairing",
+        "remotePairing",
+        "rp_pairing_file",
+        "remote_pairing_file",
+    ] {
+        if let Some(nested) = dict.get(key) {
+            return match nested {
+                Value::Dictionary(_) => decode(nested.clone(), depth + 1),
+                // Serialized and dictionary wrappers share one depth budget.
+                Value::Data(bytes) => normalize_nested(bytes, depth + 1),
+                Value::String(text) => normalize_nested(text.as_bytes(), depth + 1),
+                _ => Err(invalid()),
+            };
+        }
+    }
+    Err(invalid())
+}
+
+fn json_plist(value: &serde_json::Value) -> Option<Value> {
+    let object = value.as_object()?;
+    let mut dict = Dictionary::new();
+    for (key, value) in object {
+        let parsed = if ["private_key", "public_key", "alt_irk"].contains(&key.as_str()) {
+            let bytes = match value {
+                serde_json::Value::String(s) => {
+                    base64::engine::general_purpose::STANDARD.decode(s).ok()?
+                }
+                serde_json::Value::Array(a) => a
+                    .iter()
+                    .map(|v| v.as_u64().and_then(|n| u8::try_from(n).ok()))
+                    .collect::<Option<Vec<_>>>()?,
+                _ => return None,
+            };
+            Value::Data(bytes)
+        } else if let Some(s) = value.as_str() {
+            Value::String(s.into())
+        } else if value.is_object() {
+            json_plist(value)?
+        } else {
+            continue;
+        };
+        dict.insert(key.clone(), parsed);
+    }
+    Some(Value::Dictionary(dict))
+}
+
+pub struct Staged {
+    pub path: PathBuf,
+    bytes: Vec<u8>,
+}
+
+impl Staged {
+    pub fn from_file(source: &Path, destination: &Path) -> io::Result<Self> {
+        let bytes = read(&expand_path(source))?;
+        let folder = destination.parent().unwrap_or(Path::new("."));
+        let path = folder.join(format!(".pairing-import-{}.plist", uuid::Uuid::new_v4()));
+        write_private(&path, &bytes)?;
+        Ok(Self { path, bytes })
+    }
+
+    pub fn commit(&self, destination: &Path) -> io::Result<()> {
+        write_private(destination, &self.bytes)
+    }
+}
+
+impl Drop for Staged {
+    fn drop(&mut self) {
+        self.bytes.zeroize();
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+/// Only metadata is returned to the private page; pairing contents and keys
+/// never leave the Linux process. Listing is bounded even for /proc or /usr.
+pub fn list_directory(path: &Path) -> io::Result<serde_json::Value> {
+    let path = path.canonicalize()?;
+    if !path.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::NotADirectory,
+            "Choose a directory",
+        ));
+    }
+    let mut entries = Vec::new();
+    let mut truncated = false;
+    for item in std::fs::read_dir(&path)? {
+        if entries.len() == 256 {
+            truncated = true;
+            break;
+        }
+        let item = item?;
+        let child = item.path();
+        let directory = child.is_dir();
+        let extension = child
+            .extension()
+            .and_then(|e| e.to_str())
+            .unwrap_or("")
+            .to_ascii_lowercase();
+        entries.push(json!({"name": item.file_name().to_string_lossy(), "path": child,
+            "directory": directory, "selectable": !directory && ["plist", "json", "mobiledevicepairing", "pairing", "xml"].contains(&extension.as_str())}));
+    }
+    entries.sort_by_key(|v| {
+        (
+            v["directory"] != true,
+            v["name"].as_str().unwrap_or("").to_ascii_lowercase(),
+        )
+    });
+    Ok(
+        json!({"directory": path, "parent": path.parent().unwrap_or(&path), "entries": entries, "truncated": truncated}),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rejects_deep_plist_containers_before_recursive_deserialization() {
+        let xml = format!(
+            "<?xml version=\"1.0\"?><plist version=\"1.0\">{}<string>x</string>{}</plist>",
+            "<array>".repeat(256),
+            "</array>".repeat(256)
+        );
+        assert!(normalize(xml.as_bytes()).is_err());
+    }
+
+    #[test]
+    fn serialized_wrappers_cannot_reset_the_recursion_limit() {
+        let mut bytes = RpPairingFile::generate("depth-test").to_bytes();
+        for depth in 1..=5 {
+            let mut wrapper = Dictionary::new();
+            wrapper.insert("RPPairing".into(), Value::Data(bytes));
+            bytes = Vec::new();
+            plist::to_writer_binary(&mut bytes, &wrapper).unwrap();
+            assert_eq!(normalize(&bytes).is_ok(), depth <= 3);
+        }
+    }
+
+    #[test]
+    fn imports_remote_pairing_and_preserves_existing_output_until_verified() {
+        let root =
+            std::env::temp_dir().join(format!("siboot-pairing-import-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&root).unwrap();
+        let source = root.join("from-ish.plist");
+        let dest = root.join("rp_pairing_file.plist");
+        let bytes = RpPairingFile::generate("test").to_bytes();
+        std::fs::write(&source, &bytes).unwrap();
+        std::fs::write(&dest, b"old pairing").unwrap();
+        let staged = Staged::from_file(&source, &dest).unwrap();
+        assert_eq!(std::fs::read(&dest).unwrap(), b"old pairing");
+        staged.commit(&dest).unwrap();
+        assert_eq!(std::fs::read(&source).unwrap(), bytes);
+        assert!(RpPairingFile::from_bytes(&std::fs::read(&dest).unwrap()).is_ok());
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            assert_eq!(
+                std::fs::metadata(&dest).unwrap().permissions().mode() & 0o777,
+                0o600
+            );
+        }
+        drop(staged);
+        assert_eq!(std::fs::read_dir(&root).unwrap().count(), 2);
+        assert!(normalize(b"not a pairing").is_err());
+        assert!(normalize(&vec![0; MAX_PAIRING + 1]).is_err());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn directory_browsing_returns_names_without_file_contents() {
+        let root = std::env::temp_dir().join(format!("siboot-browse-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(root.join("nested")).unwrap();
+        std::fs::write(root.join("phone.plist"), b"secret private key contents").unwrap();
+        let listing = list_directory(&root).unwrap();
+        assert_eq!(listing["entries"][0]["name"], "nested");
+        assert_eq!(listing["entries"][1]["selectable"], true);
+        assert!(!listing.to_string().contains("secret private key"));
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
