+fn select_ipa(args: &Args) -> Result<(Args, Option<ipa::Imported>)> {
+    use std::io::IsTerminal;
+    let mut selected = args.clone();
+    if args.command == Command::Renew {
+        selected.ipa = Some(cached_ipa(args)?);
+        return Ok((selected, None));
+    }
+    if args.command != Command::All {
+        return Ok((selected, None));
+    }
+    if args.ipa.is_some() {
+        let path = sign::local_ipa(args)?;
+        selected.ipa = Some(path.to_string_lossy().into_owned());
+        return Ok((selected, None));
+    }
+    if let Some(page) = web::page() {
+        let renewal = renew::load(&args.home).ok().flatten().map(|saved| saved.label());
+        match page.pick_ipa(&args.home.join("imports"), renewal.as_deref())
+            .ok_or_else(|| Fail::by_user("No app selected."))? {
+            web::IpaChoice::Local(path) => {
+                selected.ipa = Some(path.to_string_lossy().into_owned());
+                return Ok((selected, Some(ipa::Imported(path))));
+            }
+            web::IpaChoice::Renew => {
+                selected.command = Command::Renew;
+                selected.ipa = Some(cached_ipa(args)?);
+                return Ok((selected, None));
+            }
+        }
+    } else if std::io::stdin().is_terminal() {
+        if let Ok(Some(saved)) = renew::load(&args.home) {
+            let labels = ["Install a local IPA".into(), format!("Quick renew {}", saved.label())];
+            match ui::choose("Choose an app to install", &labels) {
+                Some(1) => {
+                    selected.command = Command::Renew;
+                    selected.ipa = Some(cached_ipa(args)?);
+                    return Ok((selected, None));
+                }
+                Some(0) => {},
+                _ => return Err(Fail::by_user("No app selected.")),
+            }
+        }
+        selected.ipa = Some(ui::ask_text(
+            "path to the local IPA", "IPA path", "/path/to/App.ipa", "IPA path: ",
+        ).ok_or_else(|| Fail::by_user("No IPA selected."))?);
+    } else {
+        return Err(Fail::known("Choose a local IPA, or pass --ipa /path/to/App.ipa."));
+    }
+    sign::local_ipa(&selected)?;
+    Ok((selected, None))
+}
+
+fn cached_ipa(args: &Args) -> Result<String> {
