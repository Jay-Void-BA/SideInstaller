+            return;
+        }
+        Some("password") => {
+            let secret = ui::ask_secret("Password test", "Password", "", "")
+                .unwrap()
+                .unwrap();
+            assert_eq!(secret, " 空 格pass ");
+            println!("PASSWORD_OK");
+            return;
+        }
+        Some("network") => {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_time()
+                .build()
+                .unwrap();
