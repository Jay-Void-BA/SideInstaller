+/// Only read public client metadata. No credentials, provisioning or device tunnel.
+pub async fn check_servers(args: &Args) -> Result<()> {
+    use isideload::anisette::{remote_v3::RemoteV3AnisetteProvider, AnisetteProvider};
+    use isideload::util::storage::InMemoryStorage;
+    use std::time::{Duration, Instant};
+    let servers = candidates(args.anisette.as_deref(), last_server(&args.home).as_deref());
+    ui::note("Checking anisette client info only; Apple login and provisioning are not tested.");
+    let permits = std::sync::Arc::new(tokio::sync::Semaphore::new(3));
+    let mut tasks = tokio::task::JoinSet::new();
+    for (index, server) in servers.iter().cloned().enumerate() {
+        let permits = permits.clone();
+        tasks.spawn(async move {
+            let _permit = permits
+                .acquire_owned()
+                .await
+                .expect("probe semaphore stays open");
+            let started = Instant::now();
+            let measured = crate::perf::span("anisette.client_info", &[("index", index as u64)]);
+            let response = tokio::time::timeout(Duration::from_secs(12), async {
+                let provider = RemoteV3AnisetteProvider::new(
+                    &server,
+                    Box::new(InMemoryStorage::new()),
+                    "0".into(),
+                )
+                .map_err(|error| crate::error_text::report_text(&error))?;
+                provider
+                    .get_client_info()
+                    .await
+                    .map_err(|error| crate::error_text::report_text(&error))?;
+                Ok::<_, String>(provider.runs_android_adi())
+            })
+            .await
+            .unwrap_or_else(|_| Err("Connection timed out after 12 seconds.".into()));
+            measured.finish(
+                if response.is_ok() {
+                    crate::perf::Outcome::Ok
+                } else {
+                    crate::perf::Outcome::Error
+                },
+                &[],
+            );
+            (server, started.elapsed().as_millis(), response)
+        });
+    }
+    let mut reachable = 0;
+    let mut errors = Vec::new();
+    while let Some(result) = tasks.join_next().await {
+        let (server, elapsed, response) = result.map_err(|error| {
+            Fail::new("Anisette check stopped unexpectedly.", error.to_string())
+        })?;
+        match response {
+            Ok(android) => {
+                reachable += 1;
+                ui::ok(&format!("{}: reachable ({elapsed} ms)", host_of(&server)));
+                if android {
+                    ui::warn("This server advertises Android ADI; Apple developer sign-in may reject it.");
+                }
+            }
+            Err(error) => {
+                ui::warn(&format!(
+                    "{}: connection failed ({elapsed} ms)",
+                    host_of(&server)
+                ));
+                ui::note(&error);
+                errors.push(format!("{}: {error}", host_of(&server)));
+            }
+        }
+    }
+    ui::note(&format!(
+        "Anisette servers reachable: {reachable}/{}",
+        servers.len()
+    ));
+    if reachable == 0 {
+        return Err(Fail::new("No anisette server could be reached. Check the DNS, proxy and certificate errors above.", errors.join("\n\n")));
+    }
+    Ok(())
+}
