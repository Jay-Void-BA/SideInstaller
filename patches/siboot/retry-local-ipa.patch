diff --git a/minis/src/i18n.js b/minis/src/i18n.js
new file mode 100644
index 0000000..b998f8f
--- /dev/null
+++ b/minis/src/i18n.js
@@ -0,0 +1,84 @@
+// Localize display text only. Input values and submitted secrets are never read.
+const i18n = (() => {
+  const chinese = __SIBOOT_CHINESE__;
+  let language = "zh-CN";
+  try { language = localStorage.getItem("siboot-language") || language; } catch (_) {}
+  const originals = new WeakMap();
+  const attributes = new WeakMap();
+  const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const templates = Object.entries(chinese).filter(([key]) => key.includes("{"))
+    .sort(([a], [b]) => b.length - a.length).map(([pattern, translated]) => {
+      const names = [];
+      let at = 0, source = "^";
+      for (const match of pattern.matchAll(/\{(\w+)\}/g)) {
+        source += escape(pattern.slice(at, match.index)) + "(.+?)";
+        names.push(match[1]); at = match.index + match[0].length;
+      }
+      return { regex: new RegExp(source + escape(pattern.slice(at)) + "$"), names, translated };
+    });
+  function translate(text) {
+    if (language === "en" || !text.trim()) return text;
+    const value = text.trim();
+    const alternate = value.charAt(0) === value.charAt(0).toUpperCase()
+      ? value.charAt(0).toLowerCase() + value.slice(1) : value.charAt(0).toUpperCase() + value.slice(1);
+    let translated = chinese[value] || chinese[alternate];
+    if (!translated) {
+      const decorated = value.match(/^([✓✔✕✗▲?]\s+|Apple:\s+)(.+)$/s);
+      if (decorated) {
+        const inner = translate(decorated[2]);
+        if (inner !== decorated[2]) translated = decorated[1] + inner;
+      }
+    }
+    if (!translated) {
+      for (const item of templates) {
+        const match = value.match(item.regex);
+        if (!match) continue;
+        const captured = Object.fromEntries(item.names.map((name, index) => [name, match[index + 1]]));
+        translated = item.translated.replace(/\{(\w+)\}/g, (_, name) => captured[name]);
+        break;
+      }
+    }
+    return translated ? text.slice(0, text.indexOf(value)) + translated + text.slice(text.indexOf(value) + value.length) : text;
+  }
+  function localize() {
+    document.documentElement.lang = language === "en" ? "en" : "zh-CN";
+    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+    while (walker.nextNode()) {
+      const node = walker.currentNode;
+      if (node.parentElement.closest("script,style,input,textarea,option,.cause p,[data-no-i18n]")) continue;
+      const previous = originals.get(node);
+      const original = previous && node.nodeValue === previous.rendered ? previous.original : node.nodeValue;
+      const rendered = translate(original);
+      originals.set(node, { original, rendered });
+      if (node.nodeValue !== rendered) node.nodeValue = rendered;
+    }
+    for (const node of document.querySelectorAll("[placeholder],[aria-label],[title]")) {
+      const saved = attributes.get(node) || {};
+      for (const attribute of ["placeholder", "aria-label", "title"]) {
+        if (!node.hasAttribute(attribute)) continue;
+        const current = node.getAttribute(attribute), previous = saved[attribute];
+        const original = previous && current === previous.rendered ? previous.original : current;
+        const rendered = translate(original);
+        saved[attribute] = { original, rendered };
+        if (current !== rendered) node.setAttribute(attribute, rendered);
+      }
+      attributes.set(node, saved);
+    }
+  }
+  let scheduled = false;
+  new MutationObserver(() => {
+    if (scheduled) return;
+    scheduled = true;
+    queueMicrotask(() => { scheduled = false; localize(); });
+  }).observe(document.body, { childList: true, subtree: true, characterData: true,
+    attributes: true, attributeFilter: ["placeholder", "aria-label", "title"] });
+  const select = document.getElementById("language");
+  select.value = language;
+  select.addEventListener("change", () => {
+    language = select.value;
+    try { localStorage.setItem("siboot-language", language); } catch (_) {}
+    localize();
+  });
+  localize();
+  return { translate };
+})();
diff --git a/minis/src/i18n.rs b/minis/src/i18n.rs
new file mode 100644
index 0000000..04266c9
--- /dev/null
+++ b/minis/src/i18n.rs
@@ -0,0 +1,181 @@
+//! Shared English/Chinese messages. Raw protocol details and input values stay unchanged.
+use std::borrow::Cow;
+use std::collections::BTreeMap;
+use std::sync::OnceLock;
+
+pub const CHINESE: &str = include_str!("../locales/zh-CN.json");
+
+fn catalog() -> &'static BTreeMap<String, String> {
+    static CATALOG: OnceLock<BTreeMap<String, String>> = OnceLock::new();
+    CATALOG.get_or_init(|| serde_json::from_str(CHINESE).expect("bundled Chinese messages"))
+}
+
+pub fn is_chinese() -> bool {
+    !cfg!(test)
+        && std::env::var("SIBOOT_LANG")
+            .ok()
+            .is_none_or(|v| !v.to_ascii_lowercase().starts_with("en"))
+}
+
+pub fn tr(text: &str) -> Cow<'_, str> {
+    if !is_chinese() {
+        return Cow::Borrowed(text);
+    }
+    translate(text)
+}
+
+fn lookup(text: &str) -> Option<&'static str> {
+    let messages = catalog();
+    if let Some(value) = messages.get(text) {
+        return Some(value);
+    }
+    let mut chars = text.chars();
+    let first = chars.next()?;
+    let alternate: String = if first.is_uppercase() {
+        first.to_lowercase().chain(chars).collect()
+    } else {
+        first.to_uppercase().chain(chars).collect()
+    };
+    messages.get(&alternate).map(String::as_str)
+}
+
+/// Match named placeholders without interpreting or translating their values.
+fn interpolate(pattern: &str, translated: &str, text: &str) -> Option<String> {
+    let mut rest = pattern;
+    let mut value = text;
+    let mut captures = BTreeMap::new();
+    while let Some(open) = rest.find('{') {
+        value = value.strip_prefix(&rest[..open])?;
+        let close = rest[open + 1..].find('}')? + open + 1;
+        let name = &rest[open + 1..close];
+        rest = &rest[close + 1..];
+        let next = rest.find('{').unwrap_or(rest.len());
+        let literal = &rest[..next];
+        let length = if literal.is_empty() {
+            if next == rest.len() {
+                value.len()
+            } else {
+                return None;
+            }
+        } else if next == rest.len() {
+            value.strip_suffix(literal)?.len()
+        } else {
+            value.find(literal)?
+        };
+        let captured = &value[..length];
+        if captured.is_empty() {
+            return None;
+        }
+        if captures
+            .insert(name, captured)
+            .is_some_and(|previous| previous != captured)
+        {
+            return None;
+        }
+        value = &value[length..];
+    }
+    if value != rest {
+        return None;
+    }
+    let mut output = String::new();
+    let mut rest = translated;
+    while let Some(open) = rest.find('{') {
+        output.push_str(&rest[..open]);
+        let close = rest[open + 1..].find('}')? + open + 1;
+        output.push_str(captures.get(&rest[open + 1..close])?);
+        rest = &rest[close + 1..];
+    }
+    output.push_str(rest);
+    Some(output)
+}
+
+pub fn translate(text: &str) -> Cow<'_, str> {
+    let trimmed = text.trim();
+    if trimmed.is_empty() {
+        return Cow::Borrowed(text);
+    }
+    let translated = lookup(trimmed)
+        .map(str::to_owned)
+        .or_else(|| {
+            let message = trimmed.strip_prefix("Apple: ")?;
+            lookup(message).map(|translated| format!("Apple: {translated}"))
+        })
+        .or_else(|| {
+            static TEMPLATES: OnceLock<Vec<(&'static str, &'static str)>> = OnceLock::new();
+            let templates = TEMPLATES.get_or_init(|| {
+                let mut templates: Vec<_> = catalog()
+                    .iter()
+                    .filter(|(key, _)| key.contains('{'))
+                    .map(|(key, value)| (key.as_str(), value.as_str()))
+                    .collect();
+                templates.sort_by_key(|(key, _)| std::cmp::Reverse(key.len()));
+                templates
+            });
+            templates
+                .iter()
+                .find_map(|(pattern, translated)| interpolate(pattern, translated, trimmed))
+        });
+    match translated {
+        Some(translated) => {
+            let leading = text.len() - text.trim_start().len();
+            let trailing = text.trim_end().len();
+            Cow::Owned(format!(
+                "{}{translated}{}",
+                &text[..leading],
+                &text[trailing..]
+            ))
+        }
+        None => Cow::Borrowed(text),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn chinese_messages_preserve_paths_placeholders_and_raw_details() {
+        assert_eq!(translate("Password"), "密码");
+        assert_eq!(
+            translate("  using /root/My App.ipa  "),
+            "  使用 /root/My App.ipa  "
+        );
+        assert_eq!(
+            translate("signed App as com.example.app"),
+            "已签名 App，标识 com.example.app"
+        );
+        assert_eq!(
+            translate("rpc frame 0x1234 failed"),
+            "rpc frame 0x1234 failed"
+        );
+        assert_eq!(
+            translate("Apple: Apple didn't confirm sending a code to your Apple devices. If one arrived, enter it; if not, try another way."),
+            "Apple: Apple 未确认向受信任设备发送验证码。若已收到可继续输入，否则请选择其他方式。"
+        );
+        assert_eq!(
+            translate("Apple: -21668 - unknown error details"),
+            "Apple: -21668 - unknown error details"
+        );
+        assert_eq!(
+            interpolate("{name} signed", "{name} 已签名", "{path} signed").as_deref(),
+            Some("{path} 已签名")
+        );
+    }
+    #[test]
+    fn every_translation_preserves_its_named_placeholders() {
+        fn placeholders(text: &str) -> Vec<&str> {
+            let mut out = Vec::new();
+            let mut rest = text;
+            while let Some(open) = rest.find('{') {
+                let close = rest[open..].find('}').expect("closing brace") + open;
+                out.push(&rest[open + 1..close]);
+                rest = &rest[close + 1..];
+            }
+            out.sort_unstable();
+            out
+        }
+        for (english, chinese) in catalog() {
+            assert!(!chinese.is_empty(), "{english}");
+            assert_eq!(placeholders(english), placeholders(chinese), "{english}");
+        }
+    }
+}
