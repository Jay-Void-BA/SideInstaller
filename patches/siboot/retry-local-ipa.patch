new file mode 100644
index 0000000..e71151f
--- /dev/null
+++ b/minis/src/retry.rs
@@ -0,0 +1,93 @@
+//! A failed step waits for a deliberate retry, keeping earlier results alive.
+
+use crate::fail::{Fail, Result};
+use crate::ui;
+
+pub async fn step<T>(
+    number: usize,
+    title: &str,
+    mut attempt: impl AsyncFnMut() -> Result<T>,
+) -> Result<T> {
+    run(
+        async || {
+            ui::step(number, title);
+            attempt().await
+        },
+        |failure| ui::retry_step(&failure.advice, &failure.raw),
+    )
+    .await
+}
+
+async fn run<T>(
+    mut attempt: impl AsyncFnMut() -> Result<T>,
+    mut offer: impl FnMut(&Fail) -> bool,
+) -> Result<T> {
+    loop {
+        match attempt().await {
+            Ok(value) => return Ok(value),
+            Err(failure) => {
+                // Cancelling a prompt or sign-in must never start it again.
+                if failure.by_user || !offer(&failure) {
+                    return Err(failure);
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn retries_only_the_failed_operation_and_keeps_earlier_work() {
+        let mut completed = Vec::new();
+        let mut attempts = 0;
+        let mut offered = 0;
+        let first = run(async || Ok("signed app"), |_| panic!("no failure"))
+            .await
+            .unwrap();
+        completed.push(first);
+        let installed = run(
+            async || {
+                attempts += 1;
+                assert_eq!(completed, ["signed app"]);
+                if attempts < 3 {
+                    Err(Fail::new("Tunnel disconnected", "reset"))
+                } else {
+                    Ok("installed app")
+                }
+            },
+            |failure| {
+                assert_eq!(failure.raw, "reset");
+                offered += 1;
+                true
+            },
+        )
+        .await
+        .unwrap();
+        assert_eq!(installed, "installed app");
+        assert_eq!(attempts, 3);
+        assert_eq!(offered, 2);
+    }
+
+    #[tokio::test]
+    async fn declining_a_retry_returns_the_original_failure() {
+        let failure = run::<()>(async || Err(Fail::new("No space", "disk full")), |_| false)
+            .await
+            .unwrap_err();
+        assert_eq!(failure.advice, "No space");
+        assert_eq!(failure.raw, "disk full");
+    }
+
+    #[tokio::test]
+    async fn cancellation_is_never_retried() {
+        let failure = run::<()>(
+            async || Err(Fail::by_user("Sign-in cancelled")),
+            |_| panic!("cancellation must not offer retry"),
+        )
+        .await
+        .unwrap_err();
+        assert!(failure.by_user);
+    }
+}
