+//! Retain the last successfully installed original IPA for a real re-sign.
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+
+use isideload::util::fs_storage::write_private;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct SavedApp {
+    pub name: String,
+    pub bundle_id: String,
+    pub version: Option<String>,
+    file: String,
+    size: u64,
+}
+
+fn directory(home: &Path) -> PathBuf {
+    home.join("renewals")
+}
+fn metadata(home: &Path) -> PathBuf {
+    directory(home).join("last-app.json")
+}
+
+impl SavedApp {
+    pub fn label(&self) -> String {
+        match &self.version {
+            Some(version) => format!("{} {version}", self.name),
+            None => self.name.clone(),
+        }
+    }
+
+    pub fn ipa(&self, home: &Path) -> io::Result<PathBuf> {
+        let name = Path::new(&self.file);
+        if name.components().count() != 1
+            || name.extension().and_then(|s| s.to_str()) != Some("ipa")
+            || uuid::Uuid::parse_str(name.file_stem().and_then(|s| s.to_str()).unwrap_or(""))
+                .is_err()
+        {
+            return Err(io::Error::other("Invalid renewal cache path"));
+        }
+        let path = directory(home).join(name);
+        let info = std::fs::symlink_metadata(&path)?;
+        if !info.is_file() || info.len() != self.size {
+            return Err(io::Error::other("The cached IPA is missing or incomplete"));
+        }
+        crate::ipa::validate(&path)?;
+        Ok(path)
+    }
+}
+
+pub fn load(home: &Path) -> io::Result<Option<SavedApp>> {
+    let file = match std::fs::File::open(metadata(home)) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        other => other?,
+    };
+    let mut bytes = Vec::new();
+    file.take(32 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 32 * 1024 {
+        return Err(io::Error::other("Renewal metadata is too large"));
+    }
+    let saved: SavedApp = serde_json::from_slice(&bytes).map_err(io::Error::other)?;
+    saved.ipa(home)?;
+    Ok(Some(saved))
+}
+
+/// A browser upload is moved, not copied. External user files stay untouched.
+/// A failed cache update never changes the previously remembered app.
+pub fn remember(
+    home: &Path,
+    source: &Path,
+    owned_upload: bool,
+    name: &str,
+    bundle_id: &str,
+    version: Option<&str>,
+) -> io::Result<()> {
+    crate::ipa::validate(source)?;
+    crate::vault::private_directory(&directory(home))?;
+    let old = load(home).ok().flatten();
+    if let Some(saved) = &old {
+        if saved.ipa(home)?.canonicalize()? == source.canonicalize()? {
+            return Ok(());
+        }
+    }
+    let filename = format!("{}.ipa", uuid::Uuid::new_v4());
+    let destination = directory(home).join(&filename);
+    let result = (|| {
+        if owned_upload {
+            std::fs::rename(source, &destination)?;
+        } else {
+            let mut options = std::fs::OpenOptions::new();
+            options.write(true).create_new(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600);
+            }
+            let mut output = options.open(&destination)?;
+            let mut input = std::fs::File::open(source)?;
+            let total = input.metadata()?.len();
+            let mut copied = 0;
+            let mut buffer = vec![0u8; 1024 * 1024];
+            loop {
+                let count = input.read(&mut buffer)?;
+                if count == 0 {
+                    break;
+                }
+                output.write_all(&buffer[..count])?;
+                copied += count as u64;
+                crate::ui::progress("saved for quick renew", copied, total);
+            }
+            output.sync_all()?;
+        }
+        let saved = SavedApp {
+            name: name.into(),
+            bundle_id: bundle_id.into(),
+            version: version.map(str::to_owned),
+            file: filename,
+            size: std::fs::metadata(&destination)?.len(),
+        };
+        saved.ipa(home)?;
+        write_private(
+            &metadata(home),
+            &serde_json::to_vec(&saved).map_err(io::Error::other)?,
+        )
+    })();
+    crate::ui::progress_end();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&destination);
+    } else if let Some(saved) = old {
+        let _ = std::fs::remove_file(directory(home).join(saved.file));
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn renews_from_an_owned_copy_without_changing_or_needing_the_original() {
+        let home = std::env::temp_dir().join(format!("siboot-renew-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&home).unwrap();
+        let original = home.join("Original.ipa");
+        let bytes = crate::ipa::tests::fixture();
+        std::fs::write(&original, &bytes).unwrap();
+        remember(
+            &home,
+            &original,
+            false,
+            "Demo",
+            "example.demo.TEAM",
+            Some("1.0"),
+        )
+        .unwrap();
+        let saved = load(&home).unwrap().unwrap();
+        let cached = saved.ipa(&home).unwrap();
+        assert_eq!(std::fs::read(&original).unwrap(), bytes);
+        assert_ne!(original, cached);
+        std::fs::remove_file(&original).unwrap();
+        assert_eq!(std::fs::read(&cached).unwrap(), bytes);
+        remember(
+            &home,
+            &cached,
+            false,
+            "Demo",
+            "example.demo.TEAM",
+            Some("1.0"),
+        )
+        .unwrap();
+        assert_eq!(std::fs::read_dir(directory(&home)).unwrap().count(), 2);
+        std::fs::write(&original, b"incomplete").unwrap();
+        assert!(remember(&home, &original, false, "Bad", "example.bad", None).is_err());
+        assert_eq!(load(&home).unwrap().unwrap().name, "Demo");
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            assert_eq!(
+                std::fs::metadata(&cached).unwrap().permissions().mode() & 0o777,
+                0o600
+            );
+        }
+        std::fs::write(&cached, b"truncated").unwrap();
+        assert!(load(&home).is_err());
+        std::fs::remove_dir_all(home).unwrap();
+    }
+    #[test]
+    fn moving_browser_uploads_replaces_only_the_previous_cache_and_blocks_traversal() {
+        let home = std::env::temp_dir().join(format!("siboot-renew-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&home).unwrap();
+        let upload = home.join("uploaded.ipa");
+        for name in ["First", "Second"] {
+            std::fs::write(&upload, crate::ipa::tests::fixture()).unwrap();
+            remember(&home, &upload, true, name, "example.demo.TEAM", None).unwrap();
+            assert!(!upload.exists());
+            assert_eq!(load(&home).unwrap().unwrap().name, name);
+            assert_eq!(std::fs::read_dir(directory(&home)).unwrap().count(), 2);
+        }
+        let mut saved = load(&home).unwrap().unwrap();
+        saved.file = "../outside.ipa".into();
+        assert!(saved.ipa(&home).is_err());
+        #[cfg(unix)]
+        {
+            let saved = load(&home).unwrap().unwrap();
+            let path = saved.ipa(&home).unwrap();
+            std::fs::remove_file(&path).unwrap();
+            std::os::unix::fs::symlink(&upload, path).unwrap();
+            assert!(load(&home).is_err());
+        }
+        std::fs::remove_dir_all(home).unwrap();
+    }
+}
