+/// A failed attempt, without ending the run or discarding completed steps.
+pub fn retry_step(advice: &str, raw: &str) -> bool {
+    progress_end();
+    warn(advice);
+    if !raw.is_empty() {
+        detail(raw);
+    }
+    web::send(json!({"t": "step_failed"}));
+    {
+        let mut ui = ui();
+        if ui.mode == Mode::Live {
+            let above = ui.settle("✕", BAD, "failed; waiting for retry");
+            ui.paint(&above);
+        }
+    }
+    let answer = match web::page() {
+        Some(page) => page.retry(advice, raw),
+        None => confirm_prompt("retry this step?", true),
+    };
+    record_answer("retry this step?", Some(if answer { "Retry" } else { "Stop" }));
+    answer
+}
