diff --git a/minis/src/ipa.rs b/minis/src/ipa.rs
new file mode 100644
index 0000000..32f6b78
--- /dev/null
+++ b/minis/src/ipa.rs
@@ -0,0 +1,171 @@
+//! Bounded uploads from Files into Minis, with a private staging file.
+
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+
+pub const CHUNK_SIZE: usize = 256 * 1024;
+pub const MAX_SIZE: u64 = 4 * 1024 * 1024 * 1024;
+
+/// Only a browser-uploaded copy is owned here; a --ipa path is never deleted.
+pub struct Imported(pub PathBuf);
+
+impl Drop for Imported {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+
+pub struct Upload {
+    path: PathBuf,
+    file: std::fs::File,
+    total: u64,
+    received: u64,
+}
+
+impl Upload {
+    pub fn new(folder: &Path, total: u64) -> io::Result<Self> {
+        std::fs::create_dir_all(folder)?;
+        let path = folder.join(format!("{}.ipa.part", uuid::Uuid::new_v4()));
+        let mut options = std::fs::OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(&path)?;
+        Ok(Self {
+            path,
+            file,
+            total,
+            received: 0,
+        })
+    }
+
+    /// Each chunk must continue this upload exactly. A repeated first chunk
+    /// starts a new upload in the HTTP handler, so a broken transfer can retry.
+    pub fn append(
+        &mut self,
+        offset: u64,
+        total: u64,
+        bytes: &[u8],
+    ) -> Result<Option<PathBuf>, u16> {
+        if offset != self.received || total != self.total {
+            return Err(409);
+        }
+        if bytes.is_empty()
+            || bytes.len() > CHUNK_SIZE
+            || total == 0
+            || total > MAX_SIZE
+            || bytes.len() as u64 > total.saturating_sub(offset)
+        {
+            return Err(413);
+        }
+        self.file.write_all(bytes).map_err(|_| 500u16)?;
+        self.received += bytes.len() as u64;
+        if self.received < self.total {
+            return Ok(None);
+        }
+        self.file.flush().map_err(|_| 500u16)?;
+        validate(&self.path).map_err(|_| 422u16)?;
+        let dest = self.path.with_extension("");
+        std::fs::rename(&self.path, &dest).map_err(|_| 500u16)?;
+        Ok(Some(dest))
+    }
+}
+
+impl Drop for Upload {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+/// Opening the ZIP's central directory also rejects truncated downloads. Only
+/// read the main app's small Info.plist; the signer handles the entire bundle.
+pub fn validate(path: &Path) -> io::Result<()> {
+    let invalid = |message| io::Error::new(io::ErrorKind::InvalidData, message);
+    let file = std::fs::File::open(path)?;
+    let mut archive = zip::ZipArchive::new(file).map_err(|e| invalid(e.to_string()))?;
+    let infos: Vec<String> = archive
+        .file_names()
+        .filter(|name| {
+            let parts: Vec<_> = name.split('/').collect();
+            parts.len() == 3
+                && parts[0] == "Payload"
+                && parts[1].ends_with(".app")
+                && parts[2] == "Info.plist"
+        })
+        .map(str::to_string)
+        .collect();
+    if infos.len() != 1 {
+        return Err(invalid(
+            "The IPA must contain one app in Payload.".to_string(),
+        ));
+    }
+    let info = archive
+        .by_name(&infos[0])
+        .map_err(|e| invalid(e.to_string()))?;
+    let mut bytes = Vec::new();
+    info.take(2 * 1024 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 2 * 1024 * 1024 {
+        return Err(invalid("The app's Info.plist is too large.".to_string()));
+    }
+    let info: plist::Dictionary = plist::from_bytes(&bytes).map_err(|e| invalid(e.to_string()))?;
+    if !info
+        .get("CFBundleIdentifier")
+        .and_then(|v| v.as_string())
+        .is_some_and(|id| !id.is_empty())
+    {
+        return Err(invalid("The app has no bundle identifier.".to_string()));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+pub mod tests {
+    use super::*;
+
+    pub fn fixture() -> Vec<u8> {
+        let mut zip = zip::ZipWriter::new(io::Cursor::new(Vec::new()));
+        zip.start_file(
+            "Payload/Demo.app/Info.plist",
+            zip::write::SimpleFileOptions::default(),
+        )
+        .unwrap();
+        let mut info = plist::Dictionary::new();
+        info.insert("CFBundleIdentifier".into(), "example.demo".into());
+        plist::to_writer_xml(&mut zip, &info).unwrap();
+        zip.finish().unwrap().into_inner()
+    }
+
+    #[test]
+    fn an_upload_requires_ordered_chunks_and_a_complete_ipa() {
+        let folder = std::env::temp_dir().join(format!("siboot-upload-{}", uuid::Uuid::new_v4()));
+        let bytes = fixture();
+        let total = bytes.len() as u64;
+        let mut upload = Upload::new(&folder, total).unwrap();
+        assert_eq!(upload.append(1, total, &bytes[..4]), Err(409));
+        assert_eq!(upload.append(0, total, &bytes[..4]), Ok(None));
+        assert_eq!(upload.append(4, total + 1, &bytes[4..]), Err(409));
+        let dest = upload.append(4, total, &bytes[4..]).unwrap().unwrap();
+        drop(upload);
+        assert_eq!(std::fs::read(&dest).unwrap(), bytes);
+        assert!(validate(&dest).is_ok());
+        assert!(dest.starts_with(&folder));
+        std::fs::remove_dir_all(folder).unwrap();
+    }
+
+    #[test]
+    fn incomplete_and_invalid_uploads_are_removed() {
+        let folder = std::env::temp_dir().join(format!("siboot-upload-{}", uuid::Uuid::new_v4()));
+        let mut partial = Upload::new(&folder, 100).unwrap();
+        partial.append(0, 100, b"PK\x03\x04").unwrap();
+        drop(partial);
+        assert_eq!(std::fs::read_dir(&folder).unwrap().count(), 0);
+        let mut invalid = Upload::new(&folder, 8).unwrap();
+        assert_eq!(invalid.append(0, 8, b"PK\x03\x04junk"), Err(422));
+        drop(invalid);
+        assert_eq!(std::fs::read_dir(&folder).unwrap().count(), 0);
+        std::fs::remove_dir_all(folder).unwrap();
+    }
+}
