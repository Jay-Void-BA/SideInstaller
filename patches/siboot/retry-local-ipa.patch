@@ -0,0 +1,234 @@
+//! Offline native release probe: uses the production signer, extractor and upload manifest.
+#![allow(dead_code)]
+#[path = "../src/fail.rs"]
+mod fail;
+#[path = "../src/i18n.rs"]
+mod i18n;
+#[path = "../src/install.rs"]
+mod install;
+#[path = "../src/ipa.rs"]
+mod ipa;
+#[path = "../src/pairing_files.rs"]
+mod pairing_files;
+#[path = "../src/renew.rs"]
+mod renew;
+#[path = "../src/tunnel.rs"]
+mod tunnel;
+#[path = "../src/vault.rs"]
+mod vault;
+use rsa::{pkcs8::DecodePrivateKey, signature::Verifier};
+use siboot_perf as perf;
+use std::path::Path;
+use x509_cert::der::{Decode, DecodePem, Encode};
+
+// The probe exercises local signing and manifests, without a device or UI.
+mod ui {
+    pub fn status(_: &str) {}
+    pub fn detail(_: &str) {}
+    pub fn activity(_: &str) {}
+    pub fn warn(_: &str) {}
+    pub fn ok(_: &str) {}
+    pub fn progress(_: &str, _: u64, _: u64) {}
+    pub fn percent(_: &str, _: u64) {}
+    pub fn progress_end() {}
+}
+
+fn main() {
+    let fixture = std::env::args()
+        .nth(1)
+        .expect("usage: offline_check FIXTURE_DIRECTORY");
+    let fixture = std::fs::canonicalize(fixture).unwrap();
+    std::env::set_current_dir(&fixture).unwrap();
+    rayon::ThreadPoolBuilder::new()
+        .num_threads(1)
+        .build_global()
+        .unwrap();
+    let session = perf::start(&fixture, env!("CARGO_PKG_VERSION"), "offline_probe").unwrap();
+    probe();
+    session.finish(perf::Outcome::Ok).unwrap();
+    println!("NATIVE_OFFLINE_PROBE_OK");
+}
+
+fn probe() {
+    assert!(
+        isideload::anisette::remote_v3::RemoteV3AnisetteProvider::new(
+            "https://new.ani.sidestore.io",
+            Box::new(isideload::util::storage::InMemoryStorage::new()),
+            "0".into(),
+        )
+        .is_ok(),
+        "the standalone client must build even without a system CA bundle"
+    );
+    assert!(isideload::auth::grandslam::GrandSlam::build_reqwest_client(false).is_ok());
+    println!("BUNDLED_TLS_ROOTS_OK");
+    let home = Path::new("test-storage");
+    let lock = vault::Lock::acquire(home).unwrap();
+    assert!(vault::Lock::acquire(home).is_err());
+    let saved = vault::create(
+        home,
+        vault::Credentials {
+            apple_id: "offline@example.invalid".into(),
+            password: "test-only-password".into(),
+        },
+        "different local passphrase",
+    )
+    .unwrap();
+    assert!(vault::unlock(home, "wrong local passphrase").is_err());
+    let login = vault::unlock(home, "different local passphrase").unwrap();
+    assert_eq!(login.credentials.password, "test-only-password");
+    assert!(!std::fs::read_to_string(vault::path(home))
+        .unwrap()
+        .contains("test-only-password"));
+    saved.cipher.activate(&home.join("isideload")).unwrap();
+    drop(lock);
+    assert!(vault::Lock::acquire(home).is_ok());
+    println!("VAULT_OK");
+
+    let private =
+        rsa::RsaPrivateKey::from_pkcs8_der(&std::fs::read("test-key.der").unwrap()).unwrap();
+    let csr = isideload::sideload::cert_identity::CertificateIdentity::build_csr(&private).unwrap();
+    let csr = x509_cert::request::CertReq::from_pem(&csr).unwrap();
+    let signature = rsa::pkcs1v15::Signature::try_from(csr.signature.as_bytes().unwrap()).unwrap();
+    rsa::pkcs1v15::VerifyingKey::<sha2_10::Sha256>::new(private.to_public_key())
+        .verify(&csr.info.to_der().unwrap(), &signature)
+        .unwrap();
+    println!("CSR_OK");
+
+    let cert = x509_cert::Certificate::from_der(&std::fs::read("test-cert.der").unwrap()).unwrap();
+    let signer = apple_codesign_quick::RustCryptoCmsSigner::new(private, cert, Vec::new());
+    let workspace = isideload::sideload::workspace::ExtractionDirectory::new().unwrap();
+    let workspace_path = workspace.path().to_path_buf();
+    let mut owned_app = isideload::sideload::application::Application::new_in(
+        "Fixture.ipa".into(),
+        workspace.clone(),
+    )
+    .unwrap();
+    drop(workspace);
+    assert!(workspace_path.exists());
+    let app = &mut owned_app;
+    app.update_bundle_id("example.offline", "example.offline.TEAM")
+        .unwrap();
+    let app = &app.bundle.bundle_dir;
+    let settings = apple_codesign_quick::BundleSigningSettings::new(
+        "TEAM",
+        plist::Dictionary::new(),
+        Some(&signer),
+    );
+    apple_codesign_quick::sign_bundle(app, &settings).unwrap();
+    apple_codesign_quick::verify_bundle_resources(app).unwrap();
+    let resources: plist::Dictionary =
+        plist::from_bytes(&std::fs::read(app.join("_CodeSignature/CodeResources")).unwrap())
+            .unwrap();
+    let files = resources["files2"].as_dictionary().unwrap();
+    for name in [
+        "Resources/.config",
+        "PlugIns/Tools/injected.dylib",
+        "Hidden/.bin/driver",
+        "Resources/link.dylib",
+        "Extensions/Widget.appex/.config",
+        "Resources/large.dat",
+    ] {
+        assert!(files.contains_key(name), "missing {name}");
+    }
+    if Path::new("large-directory.fixture").exists() {
+        for index in 0..320 {
+            let name = format!("ManyFiles/resource-{index:04}.dat");
+            assert!(
+                files.contains_key(&name),
+                "directory pagination lost {name}"
+            );
+        }
+        println!("LARGE_DIRECTORY_SEALED");
+    }
+    assert_eq!(
+        files["Resources/link.dylib"].as_dictionary().unwrap()["symlink"].as_string(),
+        Some("../PlugIns/Tools/injected.dylib")
+    );
+    for image in [
+        "Main",
+        "Extensions/Widget.appex/Widget",
+        "Frameworks/Versioned.framework/Versions/A/Versioned",
+        "PlugIns/Tools/injected.dylib",
+        "Hidden/.bin/driver",
+    ] {
+        let bytes = std::fs::read(app.join(image)).unwrap();
+        assert!(bytes.len() > 512, "unsigned image {image}");
+        assert!(
+            bytes.windows(4).any(|w| w == [0xfa, 0xde, 0x0b, 0x01]),
+            "missing CMS {image}"
+        );
+    }
+    assert!(std::fs::read(app.join("Main")).unwrap().len() > 256 * 1024);
+    let mut resource = std::fs::File::open(app.join("Resources/large.dat")).unwrap();
+    let mut packet = vec![0; 1024 * 1024];
+    assert_eq!(
+        ipa::read_chunk(&mut resource, &mut packet).unwrap(),
+        packet.len()
+    );
+    assert!(packet
+        .iter()
+        .enumerate()
+        .all(|(i, byte)| *byte == (i % 251) as u8));
+    assert_eq!(ipa::read_chunk(&mut resource, &mut packet).unwrap(), 123);
+    assert_eq!(ipa::read_chunk(&mut resource, &mut packet).unwrap(), 0);
+    println!("BOUNDED_READS_LARGE_UPLOAD_PACKETS_OK");
+    let entries = install::bundle_entries(app).unwrap();
+    assert_eq!(entries.iter().filter(|e| e.symlink.is_some()).count(), 5);
+    assert!(entries.iter().any(|e| e.relative == "Resources/link.dylib"
+        && e.symlink.as_deref() == Some("../PlugIns/Tools/injected.dylib")));
+    std::fs::write(app.join("Resources/.config"), b"tampered").unwrap();
+    assert!(apple_codesign_quick::verify_bundle_resources(app).is_err());
+    println!("COMPLETE_SIGNING_OK");
+    for path in [
+        "Escape.ipa",
+        "Cycle.ipa",
+        "Absolute.ipa",
+        "Backslash.ipa",
+        "Deep.ipa",
+    ] {
+        assert!(
+            isideload::sideload::application::Application::new_in(
+                path.into(),
+                isideload::sideload::workspace::ExtractionDirectory::new().unwrap(),
+            )
+            .is_err(),
+            "accepted invalid symlink archive {path}"
+        );
+    }
+    println!("INVALID_LINKS_REJECTED");
+
+    renew::remember(
+        home,
+        Path::new("Fixture.ipa"),
+        false,
+        "Fixture",
+        "example.offline.TEAM",
+        Some("1"),
+    )
+    .unwrap();
+    std::fs::remove_file("Fixture.ipa").unwrap();
+    assert!(renew::load(home)
+        .unwrap()
+        .unwrap()
+        .ipa(home)
+        .unwrap()
+        .exists());
+    let pairing = idevice::remote_pairing::RpPairingFile::generate("offline-test");
+    isideload::util::fs_storage::write_private(
+        Path::new("original-pairing.plist"),
+        &pairing.to_bytes(),
+    )
+    .unwrap();
+    let stage = pairing_files::Staged::from_file(
+        Path::new("original-pairing.plist"),
+        Path::new("rp_pairing_file.plist"),
+    )
+    .unwrap();
+    stage.commit(Path::new("rp_pairing_file.plist")).unwrap();
+    assert!(pairing_files::read(Path::new("rp_pairing_file.plist")).is_ok());
+    println!("RENEW_PAIRING_OK");
+    assert!(workspace_path.exists());
+    drop(owned_app);
+    assert!(!workspace_path.exists());
+    println!("PRIVATE_WORKSPACE_CLEANUP_OK");
+}
