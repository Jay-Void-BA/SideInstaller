+            } else {
+                directory.join(path)
+            }
+        };
+        // Validate the selected path once, after input, rather than relying on
+        // a potentially stale listing or doing one stat for each type check.
+        match std::fs::metadata(&path) {
+            Ok(info) if info.is_dir() => directory = path,
+            Ok(info) if info.is_file() => return Some(path),
+            _ => warn("That local file cannot be read."),
+        }
     }
-    lines
 }
 
