 [package]
-name = "siboot-pair"
-version = "0.4.0"
+name = "siboot-rootshell"
+version = "0.21.4"
 edition = "2021"
-description = "siboot's pairing step for rootshell's WASM runtime: pairs the iPhone with itself from an App Store app"
+description = "Full local IPA signing, installation and renewal in rootshell by Jay-Void-BA, based on FrizzleM/siboot"
 license = "MIT"
 publish = false
 
 [[bin]]
-name = "siboot-pair"
+name = "siboot"
 path = "src/main.rs"
 
-# Its own workspace: builds for wasm32-wasip1 only.
 [workspace]
 
 [dependencies]
 futures = { version = "0.3", default-features = false, features = ["executor", "std"] }
-tokio = { version = "1", default-features = false, features = ["io-util"] }
+tokio = { version = "1", default-features = false, features = ["io-util", "rt", "time", "macros", "sync"] }
+rootshell-runtime = { path = "../SideInstaller/rust-core/vendor/rootshell-runtime" }
+isideload = { path = "../SideInstaller/rust-core/vendor/isideload", default-features = false, features = ["fs-storage"] }
+# The bounded parser uses the event API; pin its minor version as required by plist.
+plist = { version = "~1.10.0", features = ["enable_unstable_features_that_may_break_with_minor_version_bumps"] }
+serde = { version = "1", features = ["derive"] }
+serde_json = "1"
 uuid = { version = "1", features = ["v4"] }
+rootcause = "0.12"
+sha2 = "0.11"
 hex = "0.4"
+base64 = "0.22"
+scrypt = "0.12"
+chacha20poly1305 = "0.10"
+zeroize = { version = "1", features = ["derive"] }
+zip = { version = "8.3", default-features = false, features = ["deflate"] }
+tracing = "0.1"
+
+[target.'cfg(target_os = "wasi")'.dependencies]
+rootshell-http = { package = "rootshell-http", path = "../SideInstaller/rust-core/vendor/rootshell-http" }
+idevice = { path = "../SideInstaller/rust-core/vendor/idevice", default-features = false, features = ["wasm-crypto", "remote_pairing", "tunnel_tcp_stack", "rsd", "xpc", "afc", "installation_proxy", "house_arrest", "amfi"] }
+
+[target.'cfg(not(target_os = "wasi"))'.dependencies]
+reqwest = { version = "0.13", features = ["json", "gzip"] }
+idevice = { path = "../SideInstaller/rust-core/vendor/idevice", default-features = false, features = ["ring", "remote_pairing", "tunnel_tcp_stack", "rsd", "xpc", "afc", "installation_proxy", "house_arrest", "amfi"] }
+libc = "0.2"
 
-# Only the pairing code: PairableHost and the pairing file. idevice's `wasm`
-# feature is meant for browsers (wasm32-unknown-unknown), but on WASI its
-# randomness shims fall back to WASI's own `random_get`, and none of its
-# timer or JS shims are linked: the module imports nothing but WASI and
-# `rootshell_socket`.
-[target.'cfg(target_arch = "wasm32")'.dependencies]
-idevice = { path = "../SideInstaller/rust-core/vendor/idevice", default-features = false, features = ["remote_pairing", "wasm"] }
-
-# Host builds, for `cargo test`, need a TLS backend picked.
-[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
-idevice = { path = "../SideInstaller/rust-core/vendor/idevice", default-features = false, features = ["remote_pairing", "ring"] }
-
-# The fake iPhone in src/fake_iphone.rs plays the device's side of pair-setup
-# against the real pairing code, so it needs the crypto idevice's responder
-# uses, at the same versions.
 [dev-dependencies]
-tokio = { version = "1", features = ["rt-multi-thread", "macros", "net"] }
-serde_json = "1"
+apple-codesign-quick = { path = "../SideInstaller/rust-core/vendor/apple-codesign-quick" }
+rsa = { version = "0.9", features = ["sha2"] }
+x509-cert = { version = "0.2.5", features = ["pem"] }
+rootshell-http = { path = "../SideInstaller/rust-core/vendor/rootshell-http" }
+
 idevice-srp = "0.6"
 sha2-10 = { package = "sha2", version = "0.10" }
 hkdf = "0.12"
-chacha20poly1305 = "0.10"
 ed25519-dalek = "2"
-base64 = "0.22"
+
+[patch.crates-io]
+apple-codesign-quick = { path = "../SideInstaller/rust-core/vendor/apple-codesign-quick" }
 
 [profile.release]
-opt-level = "s"
-lto = true
+opt-level = 3
+lto = "thin"
 codegen-units = 1
