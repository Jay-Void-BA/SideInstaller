+async fn network(port: u16) {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let response = rootshell_http::Client::new()
+        .get(format!(
+            "http://127.0.0.1:{port}/bag?token=query-secret-never-record"
+        ))
+        .header("Authorization", "Bearer header-secret-never-record")
+        .send()
+        .await
+        .unwrap()
+        .error_for_status()
+        .unwrap()
+        .json::<serde_json::Value>()
+        .await
+        .unwrap();
+    assert_eq!(response["ok"], true);
+    let (mut ws, _) =
+        rootshell_http::websocket::connect_async(&format!("ws://127.0.0.1:{port}/provision"))
+            .await
+            .unwrap();
+    ws.send(rootshell_http::websocket::tungstenite::Message::Text(
+        "identifier-secret-never-record".into(),
+    ))
+    .await
+    .unwrap();
+    let message = ws.next().await.unwrap().unwrap();
+    assert_eq!(message.into_text().unwrap(), "provisioned");
+    ws.close(None).await.unwrap();
+    let mut socket = rootshell_runtime::Socket::connect("127.0.0.1", port, false).unwrap();
+    socket.write_all(b"ECHO").await.unwrap();
+    let tick = tokio::spawn(async {
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        7
+    });
+    let mut echoed = [0; 4];
+    tokio::time::timeout(
+        std::time::Duration::from_secs(3),
+        socket.read_exact(&mut echoed),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(&echoed, b"ECHO");
+    assert_eq!(tick.await.unwrap(), 7);
+    println!("HTTP_WEBSOCKET_COOPERATIVE_TCP_OK");
+    let mut wire = rootshell_runtime::Socket::connect("127.0.0.1", port, false).unwrap();
+    wire.write_all(b"IP4!").await.unwrap();
+    let adapter = idevice::tcp::adapter::Adapter::new(
+        Box::new(wire),
+        "10.1.0.1".parse().unwrap(),
+        "10.1.0.2".parse().unwrap(),
+    );
+    let mut adapter = adapter.to_async_handle();
+    let mut stream =
+        tokio::time::timeout(std::time::Duration::from_secs(5), adapter.connect(62078))
+            .await
+            .unwrap()
+            .unwrap();
+    let original: Vec<u8> = (0..65536).map(|i| (i % 251) as u8).collect();
+    stream.write_all(&original).await.unwrap();
+    let mut received = vec![0; original.len()];
+    tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        stream.read_exact(&mut received),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(received, original);
+    println!("SOFTWARE_TCP_STACK_OK");
+    let mut quiet = rootshell_runtime::Socket::connect("127.0.0.1", port, false).unwrap();
+    quiet
+        .set_read_timeout(std::time::Duration::from_millis(8))
+        .unwrap();
+    let mut byte = [0];
+    assert!(std::io::Read::read(&mut quiet, &mut byte).is_err());
+    println!("BLOCKING_TIMEOUT_CLASSIFIED");
+}
