+    wait(300);
+    if !ui::retry_step("The tunnel disconnected during the upload.", "connection reset (preview)") {
+        ui::failure("Install stopped.", "");
+        return false;
+    }
+    ui::step(2, "Installing it");
+    ui::done("installed (preview)");
+    ui::finish("Preview complete", &["The earlier step stayed complete while the install retried."]);
+    drop(imported);
+    let _ = std::fs::remove_dir(&folder);
+    true
+}
