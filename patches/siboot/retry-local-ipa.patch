+    fn upload_chunk(server: &Server, id: u64, offset: u64, total: u64, bytes: &[u8], origin: &str) -> u16 {
+        let mut stream = TcpStream::connect(("127.0.0.1", server.shared.port)).unwrap();
+        stream.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+        write!(stream,
+            "POST {}/upload HTTP/1.1\r\nHost: {}\r\nOrigin: {}\r\n\
+             Content-Type: application/octet-stream\r\nContent-Length: {}\r\n\
+             X-Siboot-Question: {id}\r\nX-Siboot-Offset: {offset}\r\nX-Siboot-Total: {total}\r\n\r\n",
+            base(server), host(server), origin, bytes.len()).unwrap();
+        stream.write_all(bytes).unwrap();
+        let mut first = String::new();
+        BufReader::new(stream).read_line(&mut first).unwrap();
+        first.split_whitespace().nth(1).unwrap().parse().unwrap()
+    }
