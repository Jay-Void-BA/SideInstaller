--- /dev/null
+++ b/minis/src/vault.rs
@@ -0,0 +1,362 @@
+//! Passphrase-encrypted Apple login and authenticated signing-cache storage.
+//! iSH has no system keychain; the unlock passphrase is never persisted.
+
+use std::io;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use chacha20poly1305::aead::{rand_core::RngCore, Aead, KeyInit, OsRng, Payload};
+use chacha20poly1305::{XChaCha20Poly1305, XNonce};
+use isideload::util::fs_storage::{write_private, DataProtector, FsStorage};
+use serde::{Deserialize, Serialize};
+use zeroize::{Zeroize, ZeroizeOnDrop, Zeroizing};
+
+const HEADER: &[u8; 8] = b"SIBOOT01";
+const LOGIN_AAD: &str = "siboot/apple-login/v1";
+const MAX_VAULT: u64 = 64 * 1024;
+
+#[derive(Serialize, Deserialize, Zeroize, ZeroizeOnDrop)]
+pub struct Credentials {
+    pub apple_id: String,
+    pub password: String,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Envelope {
+    version: u8,
+    salt: [u8; 16],
+    sealed: Vec<u8>,
+}
+
+pub struct SavedLogin {
+    pub credentials: Credentials,
+    pub cipher: Arc<Cipher>,
+    salt: [u8; 16],
+}
+
+pub struct Cipher {
+    key: Zeroizing<[u8; 32]>,
+}
+
+/// Hold through sign/install so two processes cannot migrate or overwrite the
+/// same encrypted cache with different keys.
+pub struct Lock(std::fs::File);
+
+impl Lock {
+    pub fn acquire(home: &Path) -> io::Result<Self> {
+        private_directory(home)?;
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true).write(true).create(true).truncate(false);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(home.join("apple-login.lock"))?;
+        #[cfg(unix)]
+        {
+            use std::os::fd::AsRawFd;
+            if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+                return Err(io::Error::new(
+                    io::ErrorKind::WouldBlock,
+                    "Another siboot run is using this login storage",
+                ));
+            }
+        }
+        Ok(Self(file))
+    }
+}
+
+impl Drop for Lock {
+    fn drop(&mut self) {
+        #[cfg(unix)]
+        {
+            use std::os::fd::AsRawFd;
+            unsafe {
+                libc::flock(self.0.as_raw_fd(), libc::LOCK_UN);
+            }
+        }
+    }
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "Wrong unlock passphrase or damaged encrypted data",
+    )
+}
+
+pub fn path(home: &Path) -> PathBuf {
+    home.join("apple-login.vault")
+}
+
+pub fn private_directory(path: &Path) -> io::Result<()> {
+    std::fs::create_dir_all(path)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700))?;
+    }
+    Ok(())
+}
+
+impl Cipher {
+    fn derive(passphrase: &str, salt: &[u8; 16]) -> io::Result<Self> {
+        let mut key = Zeroizing::new([0u8; 32]);
+        // Fixed parameters prevent a modified file from requesting unbounded
+        // memory. scrypt N=32768, r=8, p=1 uses about 32 MiB.
+        let params = scrypt::Params::new(15, 8, 1).map_err(|_| invalid())?;
+        scrypt::scrypt(passphrase.as_bytes(), salt, &params, &mut *key).map_err(|_| invalid())?;
+        Ok(Self { key })
+    }
+
+    pub fn random() -> Self {
+        let mut key = Zeroizing::new([0u8; 32]);
+        OsRng.fill_bytes(&mut *key);
+        Self { key }
+    }
+
+    fn encrypt(&self, aad: &str, plaintext: &[u8]) -> io::Result<Vec<u8>> {
+        let mut nonce = [0u8; 24];
+        OsRng.fill_bytes(&mut nonce);
+        let cipher = XChaCha20Poly1305::new_from_slice(&*self.key).map_err(|_| invalid())?;
+        let ciphertext = cipher
+            .encrypt(
+                XNonce::from_slice(&nonce),
+                Payload {
+                    msg: plaintext,
+                    aad: aad.as_bytes(),
+                },
+            )
+            .map_err(|_| invalid())?;
+        let mut out = Vec::with_capacity(32 + ciphertext.len());
+        out.extend_from_slice(HEADER);
+        out.extend_from_slice(&nonce);
+        out.extend_from_slice(&ciphertext);
+        Ok(out)
+    }
+
+    fn decrypt(&self, aad: &str, bytes: &[u8]) -> io::Result<Vec<u8>> {
+        if bytes.len() < 48 || !bytes.starts_with(HEADER) {
+            return Err(invalid());
+        }
+        let cipher = XChaCha20Poly1305::new_from_slice(&*self.key).map_err(|_| invalid())?;
+        cipher
+            .decrypt(
+                XNonce::from_slice(&bytes[8..32]),
+                Payload {
+                    msg: &bytes[32..],
+                    aad: aad.as_bytes(),
+                },
+            )
+            .map_err(|_| invalid())
+    }
+
+    /// Migrate existing plaintext keys/anisette state before enabling the
+    /// protected FsStorage backend. Interrupted migrations can resume safely.
+    pub fn activate(self: &Arc<Self>, root: &Path) -> io::Result<()> {
+        private_directory(root)?;
+        self.migrate(root, root)?;
+        FsStorage::protect_directory(root, self.clone())
+    }
+
+    fn migrate(&self, root: &Path, dir: &Path) -> io::Result<()> {
+        private_directory(dir)?;
+        for entry in std::fs::read_dir(dir)? {
+            let entry = entry?;
+            let path = entry.path();
+            let kind = entry.file_type()?;
+            if kind.is_symlink() {
+                return Err(io::Error::other(
+                    "Signing storage must not contain symlinks",
+                ));
+            }
+            if kind.is_dir() {
+                self.migrate(root, &path)?;
+            } else if kind.is_file() {
+                let relative = path
+                    .strip_prefix(root)
+                    .map_err(io::Error::other)?
+                    .to_str()
+                    .ok_or_else(invalid)?;
+                let bytes = Zeroizing::new(std::fs::read(&path)?);
+                if bytes.starts_with(HEADER) {
+                    let _checked = Zeroizing::new(self.open(relative, &bytes)?);
+                    #[cfg(unix)]
+                    {
+                        use std::os::unix::fs::PermissionsExt;
+                        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+                    }
+                } else {
+                    write_private(&path, &self.seal(relative, &bytes)?)?;
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+impl DataProtector for Cipher {
+    fn seal(&self, key: &str, data: &[u8]) -> io::Result<Vec<u8>> {
+        self.encrypt(&format!("siboot/storage/{key}"), data)
+    }
+    fn open(&self, key: &str, data: &[u8]) -> io::Result<Vec<u8>> {
+        self.decrypt(&format!("siboot/storage/{key}"), data)
+    }
+}
+
+pub fn create(home: &Path, credentials: Credentials, passphrase: &str) -> io::Result<SavedLogin> {
+    if passphrase.chars().count() < 12 || passphrase == credentials.password {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "Use a separate unlock passphrase of at least 12 characters",
+        ));
+    }
+    private_directory(home)?;
+    let mut salt = [0u8; 16];
+    OsRng.fill_bytes(&mut salt);
+    let saved = SavedLogin {
+        credentials,
+        cipher: Arc::new(Cipher::derive(passphrase, &salt)?),
+        salt,
+    };
+    saved.persist(home)?;
+    Ok(saved)
+}
+
+pub fn unlock(home: &Path, passphrase: &str) -> io::Result<SavedLogin> {
+    let file = path(home);
+    if std::fs::metadata(&file)?.len() > MAX_VAULT {
+        return Err(invalid());
+    }
+    let envelope: Envelope =
+        serde_json::from_slice(&std::fs::read(file)?).map_err(|_| invalid())?;
+    if envelope.version != 1 {
+        return Err(invalid());
+    }
+    let cipher = Arc::new(Cipher::derive(passphrase, &envelope.salt)?);
+    let plaintext = Zeroizing::new(cipher.decrypt(LOGIN_AAD, &envelope.sealed)?);
+    let credentials = serde_json::from_slice(&plaintext).map_err(|_| invalid())?;
+    Ok(SavedLogin {
+        credentials,
+        cipher,
+        salt: envelope.salt,
+    })
+}
+
+impl SavedLogin {
+    pub fn persist(&self, home: &Path) -> io::Result<()> {
+        let plaintext =
+            Zeroizing::new(serde_json::to_vec(&self.credentials).map_err(|_| invalid())?);
+        let envelope = Envelope {
+            version: 1,
+            salt: self.salt,
+            sealed: self.cipher.encrypt(LOGIN_AAD, &plaintext)?,
+        };
+        write_private(
+            &path(home),
+            &serde_json::to_vec(&envelope).map_err(|_| invalid())?,
+        )
+    }
+}
+
+pub fn forget(home: &Path) -> io::Result<()> {
+    let storage = home.join("isideload");
+    if storage.is_dir() {
+        FsStorage::unprotect_directory(&storage)?;
+        std::fs::remove_dir_all(storage)?;
+    }
+    match std::fs::remove_file(path(home)) {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+        result => result,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use isideload::util::storage::SideloadingStorage;
+
+    #[test]
+    fn login_and_cache_are_authenticated_encrypted_and_private() {
+        let home = std::env::temp_dir().join(format!("siboot-vault-{}", uuid::Uuid::new_v4()));
+        let saved = create(
+            &home,
+            Credentials {
+                apple_id: "test@example.invalid".into(),
+                password: "apple-secret".into(),
+            },
+            "separate local unlock passphrase",
+        )
+        .unwrap();
+        let raw = std::fs::read(path(&home)).unwrap();
+        assert!(!String::from_utf8_lossy(&raw).contains("apple-secret"));
+        assert!(!String::from_utf8_lossy(&raw).contains("test@example.invalid"));
+        assert!(unlock(&home, "wrong passphrase").is_err());
+        let reopened = unlock(&home, "separate local unlock passphrase").unwrap();
+        assert_eq!(reopened.credentials.password, "apple-secret");
+        let root = home.join("isideload");
+        private_directory(&root).unwrap();
+        std::fs::write(root.join("legacy-key"), b"private-key").unwrap();
+        saved.cipher.activate(&root).unwrap();
+        let storage = FsStorage::new(root.clone());
+        assert_eq!(
+            storage.retrieve_data("legacy-key").unwrap().unwrap(),
+            b"private-key"
+        );
+        storage
+            .store_data("account/developer_session.json", b"session-token")
+            .unwrap();
+        assert!(storage
+            .store_data("../outside", b"must not escape")
+            .is_err());
+        let file = root.join("account/developer_session.json");
+        let mut bytes = std::fs::read(&file).unwrap();
+        assert!(!String::from_utf8_lossy(&bytes).contains("session-token"));
+        assert_eq!(
+            storage
+                .retrieve_data("account/developer_session.json")
+                .unwrap()
+                .unwrap(),
+            b"session-token"
+        );
+        assert!(
+            saved.cipher.open("other-key", &bytes).is_err(),
+            "files cannot be swapped"
+        );
+        bytes[40] ^= 1;
+        std::fs::write(&file, bytes).unwrap();
+        assert!(
+            storage
+                .retrieve_data("account/developer_session.json")
+                .is_err(),
+            "tampering must fail closed"
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            assert_eq!(
+                std::fs::metadata(path(&home)).unwrap().permissions().mode() & 0o777,
+                0o600
+            );
+            assert_eq!(
+                std::fs::metadata(&home).unwrap().permissions().mode() & 0o777,
+                0o700
+            );
+        }
+        forget(&home).unwrap();
+        assert!(!path(&home).exists());
+        std::fs::remove_dir_all(home).unwrap();
+    }
+
+    #[test]
+    fn concurrent_logins_cannot_overwrite_the_same_vault() {
+        let home = std::env::temp_dir().join(format!("siboot-vault-lock-{}", uuid::Uuid::new_v4()));
+        let first = Lock::acquire(&home).unwrap();
+        assert!(Lock::acquire(&home).is_err());
+        drop(first);
+        let second = Lock::acquire(&home).unwrap();
+        drop(second);
+        std::fs::remove_dir_all(home).unwrap();
+    }
+}
