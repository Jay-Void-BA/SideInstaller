+/// One bounded binary chunk from Files. The key, Host and Origin checks also
+/// apply here; only the currently displayed IPA question can receive it.
+fn upload(shared: &Shared, stream: &TcpStream, request: &Request) -> io::Result<()> {
+    if !request.header("origin").is_some_and(|origin| shared.is_own_origin(origin)) {
+        return refuse(stream, 403);
+    }
+    if request.header("content-type") != Some("application/octet-stream") {
+        return refuse(stream, 415);
+    }
+    let number = |name| request.header(name).and_then(|v| v.parse::<u64>().ok());
+    let (Some(id), Some(offset), Some(total)) = (
+        number("x-siboot-question"), number("x-siboot-offset"), number("x-siboot-total"),
+    ) else { return refuse(stream, 400); };
+    if total == 0 || total > crate::ipa::MAX_SIZE || request.body.is_empty() {
+        return refuse(stream, 413);
+    }
+    let mut state = shared.lock();
+    if state.asking != Some(id) || state.answer.is_some() || state.ipa_folder.is_none() {
+        return refuse(stream, 409);
+    }
+    if offset == 0 {
+        state.upload = None;
+        match crate::ipa::Upload::new(state.ipa_folder.as_ref().unwrap(), total) {
+            Ok(upload) => state.upload = Some(upload),
+            Err(_) => return refuse(stream, 500),
+        }
+    }
+    let Some(upload) = state.upload.as_mut() else { return refuse(stream, 409); };
+    match upload.append(offset, total, &request.body) {
+        Ok(Some(path)) => {
+            state.imported_ipa = Some(path);
+            state.upload = None;
+            state.answer = Some(json!({"uploaded": true}));
+            shared.changed.notify_all();
+            respond(stream, 204, &[], b"")
+        }
+        Ok(None) => respond(stream, 204, &[], b""),
+        Err(status) => {
+            state.upload = None;
+            refuse(stream, status)
+        }
+    }
+}
