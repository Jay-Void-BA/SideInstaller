index 0000000..a152256
--- /dev/null
+++ b/rootshell/src/pair_ui.rs
@@ -0,0 +1,617 @@
+//! siboot-pair's screen, for rootshell's terminal (Ghostty).
+//!
+//! A WASM program there can't ask the terminal its size, runs on one thread
+//! and blocks in every socket call. So the screen is made of what holds up
+//! under those limits: lines that stay, and one live line at the bottom,
+//! rewritten in place and kept short enough never to wrap. It moves while the
+//! program is awake (the announcement burst); while it waits in `accept`, the
+//! live line says what for. Codes are shown in large digits and posted as
+//! notifications (OSC 777), which rootshell shows in the background too.
+//!
+//! Plain lines with `--plain` or TERM=dumb, and in the tests.
+//!
+//! What it shows is also kept as plain lines, the run's log, which it offers
+//! to copy when it stops: through OSC 52, which Ghostty puts on the
+//! clipboard (a WASM program can't run a command to do it).
+
+use std::io::Write as _;
+use std::sync::{Mutex, MutexGuard};
+use std::time::Duration;
+
+// SGR styles, in ANSI's own colors so the terminal's theme picks the shades.
+const ACCENT: &str = "36";
+const STRONG: &str = "1;36";
+const GOOD: &str = "1;32";
+const WARN: &str = "1;33";
+const BAD: &str = "1;31";
+const DIM: &str = "2";
+const BOLD: &str = "1";
+const BADGE: &str = "1;30;46";
+
+const SPINNER: [&str; 10] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
+const FRAME: Duration = Duration::from_millis(80);
+/// An iPhone's terminal upright is about 40 columns wide; COLUMNS, when
+/// rootshell sets it, says better.
+const DEFAULT_COLUMNS: usize = 40;
+
+struct Screen {
+    fancy: bool,
+    color: bool,
+    /// Columns a line may take.
+    measure: usize,
+    /// The live line on screen, if any: mark, its style, text.
+    live: Option<(&'static str, &'static str, String)>,
+    frame: usize,
+    /// Plain output: the last live text printed, so a repeat isn't.
+    last: String,
+}
+
+static SCREEN: Mutex<Screen> = Mutex::new(Screen {
+    fancy: false,
+    color: false,
+    measure: DEFAULT_COLUMNS - 1,
+    live: None,
+    frame: 0,
+    last: String::new(),
+});
+
+/// The run's log: each line shown, plainly. Without times: reading the clock
+/// would add a WASI import 0.3.0's module doesn't have.
+struct Record {
+    lines: Vec<String>,
+    last: String,
+}
+
+static RECORD: Mutex<Record> = Mutex::new(Record { lines: Vec::new(), last: String::new() });
+
+/// Keep `text` in the run's log, unless it repeats the line before.
+fn record(text: &str) {
+    let mut r = RECORD.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    for line in text.lines() {
+        let line = line.trim_end();
+        if line.trim().is_empty() || line == r.last {
+            continue;
+        }
+        r.last = line.to_string();
+        // A run is a few dozen lines: a long one keeps its start and its end.
+        if r.lines.len() >= 2000 {
+            r.lines.remove(100);
+        }
+        r.lines.push(line.to_string());
+    }
+}
+
+/// The run's log so far.
+pub fn recorded() -> Vec<String> {
+    RECORD.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).lines.clone()
+}
+
+fn screen() -> MutexGuard<'static, Screen> {
+    SCREEN
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+pub fn init(plain: bool) {
+    let mut s = screen();
+    s.fancy = !plain && !cfg!(test) && !matches!(std::env::var("TERM").as_deref(), Ok("dumb"));
+    s.color = s.fancy && std::env::var_os("NO_COLOR").is_none();
+    let columns = std::env::var("COLUMNS")
+        .ok()
+        .and_then(|c| c.trim().parse::<usize>().ok())
+        .filter(|c| (20..=400).contains(c))
+        .unwrap_or(DEFAULT_COLUMNS);
+    s.measure = columns.min(72) - 1;
+}
+
+/// How a line that stays starts.
+#[derive(Clone, Copy)]
+pub enum Mark {
+    Good,
+    Warn,
+    Info,
+}
+
+impl Mark {
+    fn glyph(self) -> (&'static str, &'static str) {
+        match self {
+            Mark::Good => ("✓", GOOD),
+            Mark::Warn => ("▲", WARN),
+            Mark::Info => ("·", DIM),
+        }
+    }
+
+    /// Plain output's, as siboot-pair always printed them.
+    fn word(self) -> &'static str {
+        match self {
+            Mark::Good => "OK",
+            Mark::Warn => "!!",
+            Mark::Info => "  ",
+        }
+    }
+}
+
+impl Screen {
+    fn paint(&self, style: &str, text: &str) -> String {
+        if self.color && !style.is_empty() && !text.is_empty() {
+            format!("\x1b[{style}m{text}\x1b[0m")
+        } else {
+            text.to_string()
+        }
+    }
+
+    fn live_line(&self) -> String {
+        match &self.live {
+            Some((mark, style, text)) => {
+                let room = self.measure.saturating_sub(4);
+                format!("  {} {}", self.paint(style, mark), cut(text, room))
+            }
+            None => String::new(),
+        }
+    }
+
+    /// Print `lines` to stay, above the live line.
+    fn emit(&mut self, lines: &[String]) {
+        let mut out = String::new();
+        if self.fancy && self.live.is_some() {
+            out.push_str("\r\x1b[2K");
+        }
+        for line in lines {
+            out.push_str(line);
+            out.push('\n');
+        }
+        if self.fancy && self.live.is_some() {
+            out.push_str(&self.live_line());
+        }
+        print!("{out}");
+        let _ = std::io::stdout().flush();
+    }
+
+    fn set_live(&mut self, mark: &'static str, style: &'static str, text: &str) {
+        if !self.fancy {
+            if self.last != text {
+                self.last = text.to_string();
+                println!("  {text}");
+            }
+            return;
+        }
+        self.live = Some((mark, style, text.to_string()));
+        print!("\r\x1b[2K{}", self.live_line());
+        let _ = std::io::stdout().flush();
+    }
+
+    /// `text` after `lead`, wrapped, its other lines indented to match.
+    fn hanging(&self, lead: &str, lead_width: usize, style: &str, text: &str) -> Vec<String> {
+        let room = self.measure.saturating_sub(lead_width).max(10);
+        wrap(text, room)
+            .into_iter()
+            .enumerate()
+            .map(|(n, piece)| {
+                let start = if n == 0 {
+                    lead.to_string()
+                } else {
+                    " ".repeat(lead_width)
+                };
+                format!("{start}{}", self.paint(style, &piece))
+            })
+            .collect()
+    }
+}
+
+/// The name and version, and what it does.
+pub fn header(version: &str) {
+    record(&format!("siboot-pair {version} log"));
+    let mut s = screen();
+    let lines = if s.fancy {
+        let mut lines = vec![
+            String::new(),
+            format!(
+                "  {} {}",
+                s.paint(BADGE, " siboot-pair "),
+                s.paint(DIM, version)
+            ),
+        ];
+        lines.extend(s.hanging("  ", 2, "", "Pairs this iPhone with itself, for siboot."));
+        lines
+    } else {
+        vec![format!(
+            "siboot-pair {version} — pairs this iPhone with itself"
+        )]
+    };
+    s.emit(&lines);
+}
+
+/// A line to keep in mind, marked.
+pub fn say(mark: Mark, text: &str) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    record(&format!("{} {text}", mark.word()));
+    let mut s = screen();
+    let lines = if s.fancy {
+        let (glyph, style) = mark.glyph();
+        let lead = format!("  {} ", s.paint(style, glyph));
+        s.hanging(&lead, 4, "", text)
+    } else {
+        vec![format!("{} {text}", mark.word())]
+    };
+    s.emit(&lines);
+}
+
+/// A paragraph, wrapped; `style` is one of `heading`'s or `dim`'s.
+fn paragraph(style: &str, text: &str) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    record(&format!("   {text}"));
+    let mut s = screen();
+    let lines = if s.fancy {
+        s.hanging("  ", 2, style, text)
+    } else {
+        vec![text.to_string()]
+    };
+    s.emit(&lines);
+}
+
+pub fn text(text: &str) {
+    paragraph("", text);
+}
+
+pub fn heading(text: &str) {
+    paragraph(BOLD, text);
+}
+
+pub fn dim(text: &str) {
+    paragraph(DIM, text);
+}
+
+/// Step `n` of a list, its other lines indented under its text.
+pub fn numbered(n: usize, text: &str) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    record(&format!("   {n}. {text}"));
+    let mut s = screen();
+    let lines = if s.fancy {
+        let lead = format!("  {} ", s.paint(STRONG, &format!("{n:>2}")));
+        s.hanging(&lead, 5, "", text)
+    } else {
+        vec![format!("  {n}. {text}")]
+    };
+    s.emit(&lines);
+}
+
+/// A command to type, on one line however long, so it copies whole.
+pub fn command(text: &str) {
+    record(&format!("     {text}"));
+    let mut s = screen();
+    let line = format!("    {}", s.paint(ACCENT, text));
+    s.emit(&[line]);
+}
+
+pub fn blank() {
+    screen().emit(&[String::new()]);
+}
+
+/// The live line: what siboot-pair is waiting for now.
+pub fn live(text: &str) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    record(&format!(" … {text}"));
+    screen().set_live("◆", STRONG, text);
+}
+
+/// The live line with a spinner, for `time`: it moves only while the program
+/// is awake, as it is between announcements.
+pub fn spin(text: &str, time: Duration) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    record(&format!(" … {text}"));
+    let frames = (time.as_millis() / FRAME.as_millis()).max(1);
+    for _ in 0..frames {
+        {
+            let mut s = screen();
+            if s.fancy {
+                s.frame = s.frame.wrapping_add(1);
+                let glyph = SPINNER[s.frame % SPINNER.len()];
+                s.set_live(glyph, ACCENT, text);
+            } else {
+                s.set_live("", "", text);
+            }
+        }
+        std::thread::sleep(FRAME);
+    }
+}
+
+/// The live line ends as a line that stays.
+pub fn settle(mark: Mark, text: &str) {
+    let translated = crate::i18n::tr(text);
+    let text = translated.as_ref();
+    let mut s = screen();
+    if s.fancy && s.live.take().is_some() {
+        print!("\r\x1b[2K");
+    }
+    s.last.clear();
+    drop(s);
+    say(mark, text);
+}
+
+/// The live line, if any, is left as it was, and the output ends with a newline.
+pub fn end() {
+    let mut s = screen();
+    if s.fancy && s.live.take().is_some() {
+        println!();
+        let _ = std::io::stdout().flush();
+    }
+}
+
+/// A failure: the live line, if any, becomes it.
+pub fn stopped(problem: &str) {
+    record(&format!("Stopped: {problem}"));
+    let mut s = screen();
+    if s.fancy && s.live.take().is_some() {
+        print!("\r\x1b[2K");
+    }
+    let lines = if s.fancy {
+        let lead = format!("  {} ", s.paint(BAD, "✗"));
+        let mut lines = vec![String::new()];
+        lines.extend(s.hanging(&lead, 4, "", &format!("Stopped: {problem}")));
+        lines
+    } else {
+        vec![String::new(), format!("Stopped: {problem}")]
+    };
+    s.emit(&lines);
+}
+
+/// `code` in large digits, three groups of three apart, and plainly under
+/// them.
+pub fn big(code: &str) {
+    // Not the code itself: the log is meant to be pasted somewhere.
+    record("     (a 6-digit code, in large digits)");
+    let mut s = screen();
+    let spaced = spaced(code);
+    if !s.fancy {
+        s.emit(&[format!("    {spaced}")]);
+        return;
+    }
+    let mut lines: Vec<String> = big_digits(code)
+        .into_iter()
+        .map(|row| format!("    {}", s.paint(STRONG, &row)))
+        .collect();
+    lines.push(format!("    {}", s.paint(DIM, &spaced)));
+    s.emit(&lines);
+}
+
+/// A notification, which rootshell's terminal posts even with rootshell in
+/// the background (OSC 777, as Ghostty reads it).
+pub fn notify(title: &str, body: &str) {
+    if cfg!(test) {
+        return;
+    }
+    let clean = |t: &str| t.replace([';', '\x07', '\x1b'], " ");
+    print!("\x1b]777;notify;{};{}\x07", clean(title), clean(body));
+    let _ = std::io::stdout().flush();
+}
+
+/// A question answered with a line: a WASM program can't read keys one at a
+/// time. None at the end of input. `hint` follows it, dimmed: "y/n". The
+/// question, hint and answer fit 40 columns, or the answer would wrap.
+pub fn ask(question: &str, hint: &str) -> Option<String> {
+    let s = screen();
+    let prompt = if s.fancy {
+        format!("  {} {} {} ", s.paint(STRONG, "◆"), s.paint(BOLD, question), s.paint(DIM, hint))
+    } else {
+        format!("{question} [{hint}] ")
+    };
+    drop(s);
+    print!("{prompt}");
+    let _ = std::io::stdout().flush();
+    let mut line = String::new();
+    match std::io::stdin().read_line(&mut line) {
+        Ok(0) | Err(_) => {
+            println!();
+            None
+        }
+        Ok(_) => {
+            let answer = line.trim().to_string();
+            record(&format!(" ?  {question} {answer}"));
+            Some(answer)
+        }
+    }
+}
+
+/// `text` onto the clipboard: OSC 52, which Ghostty, rootshell's terminal,
+/// takes as a copy. Nothing says whether it did.
+pub fn copy(text: &str) {
+    if cfg!(test) {
+        return;
+    }
+    print!("\x1b]52;c;{}\x07", base64(text.as_bytes()));
+    let _ = std::io::stdout().flush();
+}
+
+/// Standard base64, with padding, as OSC 52 takes it.
+fn base64(bytes: &[u8]) -> String {
+    const ALPHABET: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let n = chunk.iter().enumerate().fold(0u32, |n, (i, b)| n | (*b as u32) << (16 - 8 * i));
+        for i in 0..4 {
+            if i <= chunk.len() {
+                out.push(ALPHABET[(n >> (18 - 6 * i) & 63) as usize] as char);
+            } else {
+                out.push('=');
+            }
+        }
+    }
+    out
+}
+
+/// "481 516".
+pub fn spaced(code: &str) -> String {
+    let (a, b) = code.split_at(code.len().min(3));
+    format!("{a} {b}")
+}
+
+/// Digits three rows tall in heavy box-drawing lines, which Ghostty draws
+/// itself, so they join up whatever the font.
+const DIGITS: [[&str; 3]; 10] = [
+    ["┏━┓", "┃ ┃", "┗━┛"],
+    ["╺┓ ", " ┃ ", "╺┻╸"],
+    ["╺━┓", "┏━┛", "┗━╸"],
+    ["╺━┓", "╺━┫", "╺━┛"],
+    ["╻ ╻", "┗━┫", "  ╹"],
+    ["┏━╸", "┗━┓", "╺━┛"],
+    ["┏━╸", "┣━┓", "┗━┛"],
+    ["╺━┓", "  ┃", "  ╹"],
+    ["┏━┓", "┣━┫", "┗━┛"],
+    ["┏━┓", "┗━┫", "╺━┛"],
+];
+
+/// `code`'s three rows in large digits, a gap after the third.
+fn big_digits(code: &str) -> [String; 3] {
+    let mut rows: [String; 3] = Default::default();
+    for (i, d) in code.chars().filter_map(|c| c.to_digit(10)).enumerate() {
+        for (row, out) in rows.iter_mut().enumerate() {
+            if i > 0 {
+                out.push_str(if i % 3 == 0 { "   " } else { " " });
+            }
+            out.push_str(DIGITS[d as usize][row]);
+        }
+    }
+    rows
+}
+
+/// Columns a character takes: two for East Asian wide characters and emoji.
+fn char_width(c: char) -> usize {
+    let cp = c as u32;
+    if cp < 0x20 || (0x0300..=0x036f).contains(&cp) || (0xfe00..=0xfe0f).contains(&cp) {
+        return 0;
+    }
+    let wide = (0x1100..=0x115f).contains(&cp)
+        || (0x2e80..=0xa4cf).contains(&cp)
+        || (0xac00..=0xd7a3).contains(&cp)
+        || (0xf900..=0xfaff).contains(&cp)
+        || (0xff00..=0xff60).contains(&cp)
+        || (0x1f300..=0x1f6ff).contains(&cp)
+        || (0x1f900..=0x1f9ff).contains(&cp);
+    if wide {
+        2
+    } else {
+        1
+    }
+}
+
+fn width(text: &str) -> usize {
+    text.chars().map(char_width).sum()
+}
+
+/// `text` cut to `room` columns, with … where it's cut.
+fn cut(text: &str, room: usize) -> String {
+    if width(text) <= room {
+        return text.to_string();
+    }
+    let mut out = String::new();
+    let mut used = 1;
+    for c in text.chars() {
+        let w = char_width(c);
+        if used + w > room {
+            break;
+        }
+        out.push(c);
+        used += w;
+    }
+    out.push('…');
+    out
+}
+
+/// Words in lines of at most `room` columns; a longer word is cut.
+fn wrap(text: &str, room: usize) -> Vec<String> {
+    let room = room.max(1);
+    let mut lines = Vec::new();
+    let mut line = String::new();
+    let mut used = 0;
+    for word in text.split_whitespace() {
+        let w = width(word);
+        if used > 0 && used + 1 + w > room {
+            lines.push(std::mem::take(&mut line));
+            used = 0;
+        }
+        if w > room {
+            for c in word.chars() {
+                if used + char_width(c) > room {
+                    lines.push(std::mem::take(&mut line));
+                    used = 0;
+                }
+                line.push(c);
+                used += char_width(c);
+            }
+            continue;
+        }
+        if used > 0 {
+            line.push(' ');
+            used += 1;
+        }
+        line.push_str(word);
+        used += w;
+    }
+    if !line.is_empty() || lines.is_empty() {
+        lines.push(line);
+    }
+    lines
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn base64_is_the_standard_one_with_padding() {
+        assert_eq!(base64(b""), "");
+        assert_eq!(base64(b"f"), "Zg==");
+        assert_eq!(base64(b"fo"), "Zm8=");
+        assert_eq!(base64(b"foo"), "Zm9v");
+        assert_eq!(base64(b"foobar"), "Zm9vYmFy");
+        assert_eq!(base64("Settings › Pair".as_bytes()), "U2V0dGluZ3Mg4oC6IFBhaXI=");
+    }
+
+    #[test]
+    fn the_log_keeps_lines_not_codes() {
+        // Other tests log too, into the same record: these lines are its own.
+        header("9.9.9");
+        live("Waiting for the log test…");
+        live("Waiting for the log test…");
+        big("975310");
+        stopped("the log test ended.");
+        let log = recorded().join("\n");
+        assert!(log.contains("siboot-pair 9.9.9 log"), "{log}");
+        assert_eq!(log.matches("Waiting for the log test").count(), 1, "{log}");
+        assert!(!log.contains("975310") && !log.contains("975 310"), "{log}");
+        assert!(log.contains("Stopped: the log test ended."), "{log}");
+    }
+
+    #[test]
+    fn big_digits_are_three_rows_of_even_width() {
+        let rows = big_digits("481516");
+        assert_eq!(rows[0], "╻ ╻ ┏━┓ ╺┓    ┏━╸ ╺┓  ┏━╸");
+        assert_eq!(rows[1], "┗━┫ ┣━┫  ┃    ┗━┓  ┃  ┣━┓");
+        assert_eq!(rows[2], "  ╹ ┗━┛ ╺┻╸   ╺━┛ ╺┻╸ ┗━┛");
+        // Every digit is three columns, so the rows line up.
+        for (d, glyph) in DIGITS.iter().enumerate() {
+            assert!(glyph.iter().all(|row| width(row) == 3), "{d}");
+        }
+        assert!(rows.iter().all(|row| width(row) == 25));
+    }
+
+    #[test]
+    fn codes_read_in_two_groups() {
+        assert_eq!(spaced("481516"), "481 516");
+    }
+
+    #[test]
+    fn lines_wrap_and_cut_to_the_screen() {
+        assert_eq!(
+            wrap("Open Settings › Privacy & Security › Developer Mode", 20),
+            ["Open Settings ›", "Privacy & Security ›", "Developer Mode"]
+        );
+        assert_eq!(cut("Waiting for Settings to connect", 12), "Waiting for…");
+        assert_eq!(cut("short", 12), "short");
+    }
+}
diff --git a/rootshell/src/pairing.rs b/rootshell/src/pairing.rs
new file mode 100644
index 0000000..b8bf3cb
--- /dev/null
+++ b/rootshell/src/pairing.rs
@@ -0,0 +1,345 @@
+//! On-device pairing, using rootshell's multicast and socket ABI.
+use crate::pair_ui as ui;
+use crate::{mdns, rs};
+use idevice::remote_pairing::{
+    PairableHost, PairableHostInfo, PeerDevice, RpPairingFile, RpPairingSocket,
+};
+use std::{cell::Cell, time::Duration};
+const HOST_MODEL: &str = "Mac17,7";
+const MAX_ATTEMPTS: u32 = 3;
+const HOST_NAME: &str = "siboot";
+const PAIRING_FILE: &str = "rp_pairing_file.plist";
+const ALT_IRK_FILE: &str = "host_alt_irk";
+struct Args {
+    ip: [u8; 4],
+    port: Option<u16>,
+    service: String,
+}
+pub fn create(ip: [u8; 4], output: &std::path::Path) -> Result<(), String> {
+    let args = Args {
+        ip,
+        port: None,
+        service: mdns::PAIRABLE_HOST_TYPE.into(),
+    };
+    ui::blank();
+    ui::say(
+        ui::Mark::Warn,
+        "Keep Location Diary on (rootshell › Settings › Location Diary Mode › Session Only): it \
+         keeps rootshell running while you're in Settings.",
+    );
+    ui::blank();
+
+    let (mut file, alt_irk) = identity(output);
+    let mut info = PairableHostInfo::generate(HOST_NAME, HOST_MODEL);
+    if let Some(alt_irk) = alt_irk {
+        info.alt_irk = alt_irk;
+    }
+    let id = file.identifier.clone();
+    let txt = info.mdns_txt_records(&id);
+
+    let port = args.port.unwrap_or_else(random_port);
+    let listener =
+        rs::Socket::listen(port).map_err(|e| format!("couldn't listen on port {port}: {e}"))?;
+    let host = format!(
+        "siboot-{}.local",
+        id.split('-').next().unwrap_or("host").to_ascii_lowercase()
+    );
+    let ad = mdns::Advert {
+        service: &args.service,
+        instance: &id,
+        host: &host,
+        ip: args.ip,
+        port,
+        txt: &txt,
+    };
+
+    // A burst before waiting: nothing can be sent while blocked in accept.
+    let announcement = mdns::announcement(&ad, mdns::TTL);
+    let mut sent = 0;
+    for i in 0..3 {
+        match rs::Socket::send_datagram(&announcement, mdns::GROUP, mdns::PORT) {
+            Ok(()) => sent += 1,
+            Err(e) => ui::say(
+                ui::Mark::Warn,
+                &format!("Announcement {} failed: {e}", i + 1),
+            ),
+        }
+        let dots: String = (0..3).map(|n| if n <= i { '●' } else { '○' }).collect();
+        ui::spin(
+            &format!("Announcing \"Pair with {HOST_NAME}\" {dots}"),
+            Duration::from_secs(1),
+        );
+    }
+    if sent == 0 {
+        return Err(
+            "rootshell couldn't send the Bonjour announcement. Allow it Local Network \
+                    access (Settings › Privacy & Security › Local Network › rootshell) and run \
+                    this again."
+                .into(),
+        );
+    }
+    let [a, b, c, d] = args.ip;
+    ui::settle(
+        ui::Mark::Good,
+        &format!("Announced \"Pair with {HOST_NAME}\""),
+    );
+    ui::say(
+        ui::Mark::Info,
+        &format!("from {a}.{b}.{c}.{d}, port {port}"),
+    );
+    ui::blank();
+    ui::heading("Now, on this iPhone:");
+    ui::numbered(
+        1,
+        "Open Settings › Privacy & Security › Developer Mode, and scroll to the bottom.",
+    );
+    ui::numbered(
+        2,
+        &format!("Tap \"Pair with {HOST_NAME}\". It can take a few seconds to appear."),
+    );
+    ui::numbered(
+        3,
+        "Enter your passcode, then the 6-digit code. It arrives as a notification.",
+    );
+    ui::blank();
+    ui::live("Waiting for Settings…");
+
+    let peer = pair(&listener, &info, &mut file, show_code)?;
+    drop(listener);
+
+    isideload::util::fs_storage::write_private(output, &file.to_bytes())
+        .map_err(|e| format!("paired, but couldn't save pairing: {e}"))?;
+    let _ = std::fs::write(
+        output.with_file_name(ALT_IRK_FILE),
+        hex::encode(info.alt_irk),
+    );
+    // Withdraw the entry: nothing listens behind it now.
+    let _ = rs::Socket::send_datagram(&mdns::announcement(&ad, 0), mdns::GROUP, mdns::PORT);
+
+    ui::settle(
+        ui::Mark::Good,
+        &format!("Paired with {} ({})", peer.name, peer.model),
+    );
+    ui::say(
+        ui::Mark::Good,
+        &format!("Pairing file saved: Files › rootshell › {PAIRING_FILE}"),
+    );
+    Ok(())
+}
+fn pair(
+    listener: &rs::Socket,
+    info: &PairableHostInfo,
+    file: &mut RpPairingFile,
+    show: impl Fn(&str),
+) -> Result<PeerDevice, String> {
+    for attempt in 1..=MAX_ATTEMPTS {
+        let waiting = rootshell_runtime::perf::span(
+            "pairing.wait_for_settings",
+            &[("attempt", attempt as u64)],
+        );
+        rootshell_runtime::perf::checkpoint();
+        let stream = listener
+            .accept()
+            .map_err(|e| format!("couldn't accept the connection: {e}"))?;
+        waiting.finish(rootshell_runtime::perf::Outcome::Ok, &[]);
+        let exchange = rootshell_runtime::perf::span("pairing.handshake", &[]);
+        rootshell_runtime::perf::checkpoint();
+        ui::live("Settings connected, waiting…");
+        let mut host = PairableHost::new(RpPairingSocket::new_device(stream), info.clone());
+        let code_shown = Cell::new(false);
+        let outcome = futures::executor::block_on(host.accept(file, |pin: String| {
+            code_shown.set(true);
+            show(&pin);
+            async {}
+        }));
+        let error = match outcome {
+            Ok(peer) => {
+                exchange.finish(rootshell_runtime::perf::Outcome::Ok, &[]);
+                return Ok(peer);
+            }
+            Err(e) => {
+                exchange.finish(rootshell_runtime::perf::Outcome::Error, &[]);
+                e.to_string()
+            }
+        };
+        let wrong_code = error.to_ascii_lowercase().contains("srp");
+        if attempt == MAX_ATTEMPTS {
+            return Err(if wrong_code {
+                "the code didn't match. Run this again and type the new code exactly.".into()
+            } else {
+                format!("pairing didn't finish ({error}). Run this again.")
+            });
+        }
+        ui::settle(
+            ui::Mark::Warn,
+            match (code_shown.get(), wrong_code) {
+                (false, _) => "That connection closed before asking for a code.",
+                (true, true) => {
+                    "That code didn't match. Tap the entry in Settings again for a new one."
+                }
+                (true, false) => {
+                    "Pairing stopped before it finished. Tap the entry in Settings again."
+                }
+            },
+        );
+        ui::live("Still waiting for Settings…");
+    }
+    unreachable!("the loop returns on its last attempt")
+}
+
+/// The code, in large digits and posted as a notification: Ghostty,
+/// rootshell's terminal, turns OSC 777 into one, also with rootshell in the
+/// background.
+fn show_code(pin: &str) {
+    ui::settle(ui::Mark::Good, "Settings connected");
+    ui::blank();
+    ui::heading("Type this code into Settings:");
+    ui::big(pin);
+    ui::dim("It's in your notifications too.");
+    ui::blank();
+    ui::notify(
+        "siboot pairing code",
+        &format!("{} — type it into Settings", ui::spaced(pin)),
+    );
+    ui::live("Waiting for Settings to check it…");
+}
+
+/// The host identity from an earlier run, so a new pairing doesn't invalidate
+/// copies of the file handed out before; else a new one.
+fn identity(output: &std::path::Path) -> (RpPairingFile, Option<[u8; 16]>) {
+    let file = match rootshell_runtime::vfs::read(output)
+        .ok()
+        .and_then(|b| RpPairingFile::from_bytes(&b).ok())
+    {
+        Some(mut existing) => {
+            existing.alt_irk = None;
+            existing
+        }
+        None => fresh_identity(),
+    };
+    let alt_irk = std::fs::read_to_string(output.with_file_name(ALT_IRK_FILE))
+        .ok()
+        .and_then(|h| hex::decode(h.trim()).ok())
+        .and_then(|b| b.try_into().ok());
+    (file, alt_irk)
+}
+
+/// `generate` derives the identifier from the name, the same for every
+/// siboot; a random one keeps this host's records apart.
+fn fresh_identity() -> RpPairingFile {
+    let mut fresh = RpPairingFile::generate(HOST_NAME);
+    fresh.identifier = uuid::Uuid::new_v4().to_string().to_uppercase();
+    fresh
+}
+
+fn random_port() -> u16 {
+    let b = uuid::Uuid::new_v4();
+    let n = u16::from_be_bytes([b.as_bytes()[0], b.as_bytes()[1]]);
+    50000 + n % 10000
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::fake_iphone;
+    type PairingResult = (Result<PeerDevice, String>, RpPairingFile);
+    /// A host waiting on a loopback port, as Settings finds it, pairing in a
+    /// thread of its own (the real one blocks in accept). The codes it shows
+    /// come out of the receiver.
+    fn host() -> (
+        u16,
+        std::sync::mpsc::Receiver<String>,
+        std::thread::JoinHandle<PairingResult>,
+    ) {
+        let listener = rs::Socket::listen(0).unwrap();
+        let port = listener.local_port();
+        let (codes, shown) = std::sync::mpsc::channel();
+        let thread = std::thread::spawn(move || {
+            let info = PairableHostInfo::generate(HOST_NAME, HOST_MODEL);
+            let mut file = fresh_identity();
+            let paired = pair(&listener, &info, &mut file, |pin| {
+                codes.send(pin.to_string()).unwrap()
+            });
+            (paired, file)
+        });
+        (port, shown, thread)
+    }
+
+    fn addr(port: u16) -> std::net::SocketAddr {
+        std::net::SocketAddr::from(([127, 0, 0, 1], port))
+    }
+
+    /// The fake iPhone's typing: the next code the host shows.
+    async fn next_code(
+        shown: std::sync::Arc<std::sync::Mutex<std::sync::mpsc::Receiver<String>>>,
+    ) -> String {
+        tokio::task::spawn_blocking(move || shown.lock().unwrap().recv().unwrap())
+            .await
+            .unwrap()
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_device_pairs_and_the_file_holds_the_host_it_saw() {
+        let (port, shown, host) = host();
+        let shown = std::sync::Arc::new(std::sync::Mutex::new(shown));
+        let phone = fake_iphone::pair(addr(port), next_code(shown))
+            .await
+            .expect("phone paired");
+        let (paired, file) = host.join().unwrap();
+        let peer = paired.expect("host paired");
+        assert_eq!(peer.name, fake_iphone::NAME);
+        assert_eq!(peer.model, fake_iphone::MODEL);
+        // The identity the device was given in M6 is the one written out…
+        assert_eq!(file.identifier, phone.host_identifier);
+        assert_eq!(file.public_key_bytes(), phone.host_public_key);
+        // …with the device's altIRK from M5, and it reads back.
+        assert_eq!(file.alt_irk.as_deref(), Some(&fake_iphone::ALT_IRK[..]));
+        let reread = RpPairingFile::from_bytes(&file.to_bytes()).unwrap();
+        assert_eq!(reread.identifier, file.identifier);
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_wrong_code_gets_another_try() {
+        let (port, shown, host) = host();
+        let shown = std::sync::Arc::new(std::sync::Mutex::new(shown));
+        // A typo, then the entry tapped again and the new code typed.
+        let first = fake_iphone::pair(addr(port), async { "000000".to_string() }).await;
+        assert!(first.is_err(), "a wrong code paired");
+        let _typo = next_code(shown.clone()).await;
+        fake_iphone::pair(addr(port), next_code(shown))
+            .await
+            .expect("the second try paired");
+        let (paired, _) = host.join().unwrap();
+        assert_eq!(
+            paired.expect("host paired on the second try").name,
+            fake_iphone::NAME
+        );
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn three_wrong_codes_end_the_run_and_say_why() {
+        let (port, _shown, host) = host();
+        for _ in 0..MAX_ATTEMPTS {
+            let paired = fake_iphone::pair(addr(port), async { "000000".to_string() }).await;
+            assert!(paired.is_err(), "a wrong code paired");
+        }
+        let (paired, _) = host.join().unwrap();
+        let problem = paired.expect_err("the host should give up");
+        assert!(problem.contains("code didn't match"), "{problem}");
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn a_connection_that_drops_before_the_code_doesnt_end_pairing() {
+        let (port, shown, host) = host();
+        drop(std::net::TcpStream::connect(addr(port)).unwrap());
+        let shown = std::sync::Arc::new(std::sync::Mutex::new(shown));
+        fake_iphone::pair(addr(port), next_code(shown))
+            .await
+            .expect("phone paired");
+        let (paired, _) = host.join().unwrap();
+        assert_eq!(
+            paired.expect("host paired after the stray connection").name,
+            fake_iphone::NAME
+        );
+    }
+}
