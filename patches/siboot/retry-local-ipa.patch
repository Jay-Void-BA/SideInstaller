+    );
+    let answer = ui::ask("Press Return after copying the IPA, or type q to cancel: ")
+        .ok_or_else(|| Fail::by_user("IPA selection cancelled."))?;
+    if answer.trim().eq_ignore_ascii_case("q") {
+        return Err(Fail::by_user("IPA selection cancelled."));
+    }
+
+    // Write only after acknowledgement, so cancelling never hides the guide.
+    // An unwritable marker should not itself prevent selecting a local IPA.
+    let saved = isideload::util::fs_storage::write_private(&marker, b"1\n");
+    rootshell_runtime::perf::event(
+        "onboarding.shown",
+        &[("persisted", u64::from(saved.is_ok()))],
+    );
+    if let Err(error) = saved {
+        ui::warn("The import guide could not be marked as read; it will appear again next time.");
+        ui::detail(&error.to_string());
+    }
+    Ok(())
+}
