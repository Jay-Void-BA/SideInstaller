+fn save_login(args: &Args, apple_id: &str, password: &str) -> Result<Option<vault::SavedLogin>> {
+    #[cfg(not(target_os = "wasi"))]
+    use std::io::IsTerminal;
+    #[cfg(not(target_os = "wasi"))]
+    if crate::web::page().is_none() && !std::io::stdin().is_terminal() {
+        return Ok(None);
+    }
+    if !ui::confirm(
+        "save this Apple Account login securely on this device?",
+        false,
+    ) {
+        return Ok(None);
+    }
+    ui::note("Choose a separate unlock passphrase of at least 12 characters. It unlocks your saved login each time and is never saved.");
+    loop {
+        let read = |label, prompt| {
+            ui::ask_secret(
+                "Encrypt the saved login",
+                label,
+                "at least 12 characters",
+                prompt,
+            )
+            .map_err(|_| Fail::known("Couldn't read the unlock passphrase."))
+        };
+        let Some(first) = read("New unlock passphrase", "New unlock passphrase: ")? else {
+            return Ok(None);
+        };
+        let first = Zeroizing::new(first);
+        if first.chars().count() < 12 || first.as_str() == password {
+            ui::warn("Use a separate unlock passphrase of at least 12 characters.");
+            continue;
+        }
+        let Some(second) = read("Confirm unlock passphrase", "Confirm unlock passphrase: ")? else {
+            return Ok(None);
+        };
+        let second = Zeroizing::new(second);
+        if *first != *second {
+            ui::warn("The unlock passphrases didn't match.");
+            continue;
+        }
+        return vault::create(
+            &args.home,
+            vault::Credentials {
+                apple_id: apple_id.into(),
+                password: password.into(),
+            },
+            &first,
+        )
+        .map(Some)
+        .map_err(|_| Fail::known("Couldn't save the encrypted login."));
+    }
+}
