+        .ok_or_else(|| Fail::known("No app is cached for quick renew. Install a local IPA first."))?;
+    let path = saved.ipa(&args.home).map_err(|e| Fail::new("The cached IPA is incomplete. Install a local IPA again.", e.to_string()))?;
+    ui::ok(&format!("quick renew: {}", saved.label()));
+    Ok(path.to_string_lossy().into_owned())
+}
