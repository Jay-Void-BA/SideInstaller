+/// Uses generated pairing keys and dummy credentials only. No device or Apple
+/// contact; exercises the real browser, masked prompts and encrypted storage.
+fn secure_setup() -> bool {
+    use isideload::util::storage::SideloadingStorage;
+    ui::header("0.19.0", "Pairing and encrypted-login preview. Use dummy credentials only.");
+    let Some(page) = web::page() else { return false };
+    let root = std::env::temp_dir().join(format!("siboot-secure-preview-{}", std::process::id()));
+    let source = root.join("ish/Phone.plist");
+    std::fs::create_dir_all(source.parent().unwrap()).unwrap();
+    std::fs::write(&source, idevice::remote_pairing::RpPairingFile::generate("preview").to_bytes()).unwrap();
+    let destination = root.join("rp_pairing_file.plist");
+    ui::note(&format!("Preview iSH folder: {}", source.parent().unwrap().display()));
+    ui::plan(&["Pairing", "Save login", "Unlock"], 3);
+    ui::step(1, "Selecting an existing pairing file");
+    let Some(Some(selected)) = page.pairing_file(&destination) else { return false };
+    let staged = pairing_files::Staged::from_file(&selected, &destination).unwrap();
+    staged.commit(&destination).unwrap();
+    drop(staged);
+    ui::done("private pairing copy saved (preview only; no device verification)");
+    ui::step(2, "Encrypting dummy login and signing data");
+    let Some(password) = ui::ask_secret("Preview: dummy Apple password", "Password", "use a dummy password", "Password: ").unwrap() else { return false };
+    if !ui::confirm("save this dummy login securely?", false) { return false }
+    let read = |label| ui::ask_secret("Encrypt the saved login", label, "at least 12 characters", "Passphrase: ").unwrap();
+    let Some(first) = read("New unlock passphrase") else { return false };
+    let Some(second) = read("Confirm unlock passphrase") else { return false };
+    if first != second { return false }
+    let saved = vault::create(&root, vault::Credentials { apple_id: "preview@example.invalid".into(), password }, &first).unwrap();
+    let storage = root.join("isideload");
+    saved.cipher.activate(&storage).unwrap();
+    isideload::util::fs_storage::FsStorage::new(storage.clone()).store_data("account/token", b"preview-token").unwrap();
+    ui::done("dummy login and cache encrypted");
+    ui::step(3, "Unlocking the saved login");
+    loop {
+        let Some(phrase) = ui::ask_secret("Unlock saved login", "Unlock passphrase", "your local storage passphrase", "Passphrase: ").unwrap() else { return false };
+        match vault::unlock(&root, &phrase) {
+            Ok(_) => break,
+            Err(_) => ui::warn("Couldn't unlock the saved login. Apple has not been contacted."),
+        }
+    }
+    ui::done("saved login unlocked");
+    ui::finish("Secure setup preview complete", &["No device or Apple contact. The generated preview files will be removed."]);
+    vault::forget(&root).unwrap();
+    std::fs::remove_dir_all(root).unwrap();
+    true
+}
+
+/// Exercises the real upload and retry UI, without signing in or an iPhone.
+fn local_ipa() -> bool {
+    ui::header("0.18.1", "Local IPA and retry preview (no install).");
+    let Some(page) = web::page() else {
+        ui::failure("Use local-ipa with --web.", "");
+        return false;
+    };
+    let folder = std::env::temp_dir().join(format!("siboot-preview-{}", std::process::id()));
+    let Some(path) = page.pick_ipa(&folder) else { return false };
+    let imported = path.map(ipa::Imported);
+    ui::plan(&["IPA", "Install"], 2);
+    ui::step(1, "Preparing the IPA");
+    ui::done(if imported.is_some() { "local IPA imported" } else { "release selected" });
+    ui::step(2, "Installing it");
+    wait(300);
+    if !ui::retry_step("The tunnel disconnected during the upload.", "connection reset (preview)") {
+        ui::failure("Install stopped.", "");
+        return false;
+    }
+    ui::step(2, "Installing it");
+    ui::done("installed (preview)");
+    ui::finish("Preview complete", &["The earlier step stayed complete while the install retried."]);
+    drop(imported);
+    let _ = std::fs::remove_dir(&folder);
+    true
+}
